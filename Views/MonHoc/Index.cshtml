@model List<DMS_Examify.Models.MonHoc>

@section Styles {
    <link rel="stylesheet" href="~/css/monhoc.css" asp-append-version="true" />
}

<div class="row g-4">
    <!-- FORM -->
    <div class="col-md-5">
        <div class="card">
            <div class="card-header">Thông tin Môn học</div>
            <div class="card-body">

                <div class="mb-3">
                    <label>Mã môn học</label>
                    <input id="txtMaMH" class="form-control" />
                    <span id="errMaMH" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="mb-3">
                    <label>Tên môn học</label>
                    <input id="txtTenMH" class="form-control" />
                    <span id="errTenMH" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="d-flex gap-2 flex-wrap">
                    <span id="wrapThem" class="d-inline-block">
                        <button type="button" class="btn btn-primary" onclick="addSubject()" id="btnThem" disabled>Thêm</button>
                    </span>
                    <span id="wrapSua" class="d-inline-block">
                        <button type="button" class="btn btn-warning" onclick="editSubject()" id="btnSua" disabled>Sửa</button>
                    </span>
                    <span id="wrapGhi" class="d-inline-block">
                        <button type="button" class="btn btn-success" onclick="saveChangesToDb()" id="btnGhi" disabled>Ghi</button>
                    </span>
                    <button type="button" class="btn btn-secondary" onclick="resetForm()">Reset</button>
                </div>

            </div>
        </div>
    </div>

    <!-- TABLE -->
    <div class="col-md-7">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center py-2">
                <span>Danh sách Môn học (<span id="lblCount">@Model.Count</span>)</span>
                <div style="width: 250px;">
                    <input id="txtTim" class="form-control form-control-sm" placeholder="Tìm kiếm mã hoặc tên..." />
                </div>
            </div>

            <div class="card-body p-0">
                <table class="table table-hover" id="tbl">
                    <thead>
                        <tr>
                            <th>STT</th>
                            <th>Mã</th>
                            <th>Tên</th>
                            <th class="text-center" style="width: 100px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Count; i++)
                        {
                            <tr data-mamh="@Model[i].MaMH" data-tenmh="@Model[i].TenMH">
                                <td>@(i + 1)</td>
                                <td>@Model[i].MaMH</td>
                                <td>@Model[i].TenMH</td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-link text-warning p-0 me-2 btn-edit" title="Hiệu chỉnh"><i class="bi bi-pencil-square fs-5"></i></button>
                                    <button type="button" class="btn btn-link text-danger p-0 btn-delete" title="Xóa"><i class="bi bi-trash fs-5"></i></button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
<!-- Custom Modal for Notifications and Confirmations -->
<div class="modal fade" id="customModal" tabindex="-1" aria-labelledby="customModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-3">
            <div class="modal-header border-0 bg-light py-3">
                <h5 class="modal-title d-flex align-items-center gap-2 fw-semibold" id="customModalLabel">
                    <i id="customModalIcon" class="bi fs-4"></i>
                    <span id="customModalTitle">Thông báo</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-4 fs-6 text-dark" id="customModalMessage">
                Nội dung thông báo ở đây.
            </div>
            <div class="modal-footer border-0 bg-light py-2">
                <button type="button" class="btn btn-secondary btn-sm px-3" id="btnCustomModalCancel" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary btn-sm px-3" id="btnCustomModalOk">Xác nhận</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/monhoc.js" asp-append-version="true"></script>
}