@model List<DMS_Examify.Models.MonHoc>

@section Styles {
    <link rel="stylesheet" href="~/css/monhoc.css" asp-append-version="true" />
}

<div class="row g-4">
    <!-- FORM -->
    <div class="col-12 mb-4">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-white border-bottom fw-bold py-3">Thông tin Môn học</div>
            <div class="card-body">

                <div class="row mb-3">
                    <div class="col-md-4">
                        <label class="form-label fw-medium">Mã môn học <span class="text-danger">*</span></label>
                        <input id="txtMaMH" class="form-control text-uppercase shadow-none" maxlength="5" placeholder="Nhập mã môn học..." />
                        <span id="errMaMH" class="text-danger small mt-1 d-block"></span>
                    </div>
                    <div class="col-md-8">
                        <label class="form-label fw-medium">Tên môn học <span class="text-danger">*</span></label>
                        <input id="txtTenMH" class="form-control shadow-none" maxlength="40" placeholder="Nhập tên môn học..." />
                        <span id="errTenMH" class="text-danger small mt-1 d-block"></span>
                    </div>
                </div>

                <div class="d-flex gap-2 flex-wrap mt-2">
                    <span id="wrapThem" class="d-inline-block">
                        <button type="button" class="btn btn-primary px-4" onclick="addSubject()" id="btnThem" disabled>
                            <i class="bi bi-plus-lg me-1"></i> Thêm
                        </button>
                    </span>
                    <span id="wrapSua" class="d-inline-block">
                        <button type="button" class="btn btn-warning px-4 text-white" onclick="editSubject()" id="btnSua" disabled>
                            <i class="bi bi-pencil-square me-1"></i> Sửa
                        </button>
                    </span>
                    <button type="button" class="btn btn-secondary px-4" onclick="resetForm()">
                        <i class="bi bi-arrow-repeat me-1"></i> Đặt lại
                    </button>
                    <div class="vr mx-2 d-none d-md-block"></div>
                    <button type="button" class="btn btn-outline-info animate-btn" onclick="undoLastAction()" id="btnUndo" disabled>
                        <i class="bi bi-arrow-counterclockwise"></i> Undo
                    </button>
                    <button type="button" class="btn btn-outline-info animate-btn" onclick="redoLastAction()" id="btnRedo" disabled>
                        <i class="bi bi-arrow-clockwise"></i> Redo
                    </button>
                    <span id="wrapGhi" class="d-inline-block ms-auto">
                        <button type="button" class="btn btn-success animate-btn px-4" onclick="saveChangesToDb()" id="btnGhi" disabled>
                            <i class="bi bi-cloud-arrow-up me-1"></i> Ghi (Lưu CSDL)
                        </button>
                    </span>
                </div>

            </div>
        </div>
    </div>

    <!-- TABLE -->
    <div class="col-12">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header d-flex justify-content-between align-items-center py-2">
                <span>Danh sách Môn học (<span id="lblCount">@Model.Count</span>)</span>
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-outline-success btn-sm animate-btn text-nowrap" onclick="exportExcel()" title="Xuất Excel">
                        <i class="bi bi-file-earmark-excel"></i> Xuất Excel
                    </button>
                    <button type="button" class="btn btn-outline-primary btn-sm animate-btn text-nowrap" onclick="openImportModal()" title="Nhập dữ liệu từ file Excel">
                        <i class="bi bi-file-earmark-arrow-up"></i> Nhập Excel
                    </button>
                    <div class="input-group input-group-sm mb-0" style="width: 250px;">
                        <span class="input-group-text bg-white border-end-0 text-secondary"><i class="bi bi-search"></i></span>
                        <input id="txtTim" class="form-control border-start-0 shadow-none ps-0" placeholder="Tìm kiếm mã hoặc tên..." />
                        <button class="btn btn-outline-secondary border-start-0 d-none" type="button" id="btnClearSearch" onclick="clearSearch()">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>
                </div>
            </div>

            <div class="card-body p-0 table-responsive border rounded-3 mb-0" style="max-height: 400px; overflow-y: auto;">
                <div id="emptyState" class="text-center py-4 text-muted small d-none">
                    <i class="bi bi-info-circle fs-5 d-block mb-2 text-secondary"></i>
                    Không tìm thấy môn học nào phù hợp.
                </div>
                <table class="table table-hover align-middle mb-0" id="tbl">
                    <thead class="table-light sticky-top">
                        <tr>
                            <th>STT</th>
                            <th>Mã</th>
                            <th>Tên</th>
                            <th class="text-center" style="width: 100px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Count; i++)
                        {
                            <tr data-mamh="@Model[i].MaMH" data-tenmh="@Model[i].TenMH" data-original-tenmh="@Model[i].TenMH" data-id="@Model[i].MaMH">
                                <td>@(i + 1)</td>
                                <td>@Model[i].MaMH</td>
                                <td>@Model[i].TenMH</td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-link text-warning p-0 me-2 btn-edit" title="Hiệu chỉnh"><i class="bi bi-pencil-square fs-5"></i></button>
                                    <span class="d-inline-block" tabindex="0" title="@(Model[i].HasDependencies ? "Không thể xóa vì đã có dữ liệu liên quan" : "Xóa")">
                                        <button type="button" class="btn btn-link text-danger p-0 btn-delete" @(Model[i].HasDependencies ? "disabled style=pointer-events:none;" : "")><i class="bi bi-trash fs-5"></i></button>
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="card-footer d-flex justify-content-between align-items-center py-2 bg-light border-top-0">
                <div class="d-flex align-items-center gap-2">
                    <span class="small text-secondary fw-medium" id="lblPaginationSummary">Hiển thị từ 0 đến 0 trong tổng số 0 dòng</span>
                    <select class="form-select form-select-sm shadow-none" id="selectPageSize" style="width: 80px;" onchange="changePageSize(this.value)">
                        <option value="5">5</option>
                        <option value="10" selected>10</option>
                        <option value="20">20</option>
                        <option value="50">50</option>
                    </select>
                    <span class="small text-secondary fw-medium">dòng/trang</span>
                </div>
                <nav aria-label="Page navigation">
                    <ul class="pagination pagination-sm mb-0" id="ulPagination">
                        <!-- Pagination items injected here -->
                    </ul>
                </nav>
            </div>
        </div>
    </div>
<!-- Custom Modal for Notifications and Confirmations -->
<div class="modal fade" id="customModal" tabindex="-1" aria-labelledby="customModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-3">
            <div class="modal-header border-0 bg-light py-3">
                <h5 class="modal-title d-flex align-items-center gap-2 fw-semibold" id="customModalLabel">
                    <i id="customModalIcon" class="bi fs-4"></i>
                    <span id="customModalTitle">Thông báo</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-4 fs-6 text-dark" id="customModalMessage">
                Nội dung thông báo ở đây.
            </div>
            <div class="modal-footer border-0 bg-light py-2">
                <button type="button" class="btn btn-secondary btn-sm px-3" id="btnCustomModalCancel" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary btn-sm px-3" id="btnCustomModalOk">Xác nhận</button>
            </div>
        </div>
    </div>
</div>

<!-- Import Excel Modal -->
<div class="modal fade" id="importModal" tabindex="-1" aria-labelledby="importModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-3">
            <div class="modal-header border-0 bg-light py-3">
                <h5 class="modal-title d-flex align-items-center gap-2 fw-semibold" id="importModalLabel">
                    <i class="bi bi-file-earmark-excel-fill text-success fs-4"></i>
                    <span>Import Môn học từ Excel</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-4">
                <div class="mb-3 d-flex justify-content-between align-items-center bg-light p-3 rounded-3 border border-dashed">
                    <div>
                        <span class="fw-medium text-secondary">Tải file cấu trúc mẫu (.xlsx):</span>
                        <p class="mb-0 text-muted small">File gồm 2 cột: Mã môn học, Tên môn học</p>
                    </div>
                    <button type="button" class="btn btn-outline-success btn-sm px-3 animate-btn" onclick="downloadTemplate()">
                        <i class="bi bi-download"></i> Tải file mẫu
                    </button>
                </div>
                
                <div class="mb-4">
                    <label for="importFile" class="form-label fw-medium">Chọn file Excel (.xlsx, .xls)</label>
                    <input type="file" class="form-control shadow-none" id="importFile" accept=".xlsx, .xls" onchange="handleFileSelect(event)" />
                    <div id="importFileFeedback" class="text-danger small mt-1"></div>
                </div>

                <div id="importPreviewSection" style="display: none;">
                    <hr class="my-4 text-muted opacity-25" />
                    <h6 class="fw-semibold mb-3 d-flex justify-content-between align-items-center">
                        <span class="text-dark">Xem trước dữ liệu nhập</span>
                        <span id="importSummary" class="badge bg-secondary rounded-pill px-3 py-1.5">...</span>
                    </h6>
                    <div class="table-responsive" style="max-height: 280px; overflow-y: auto;">
                        <table class="table table-sm table-bordered table-hover align-middle mb-0" id="tblImportPreview">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th class="text-center" style="width: 50px;">STT</th>
                                    <th style="width: 150px;">Mã môn học</th>
                                    <th>Tên môn học</th>
                                    <th style="width: 200px;">Trạng thái</th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- Preview rows will be inserted here dynamically -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 bg-light py-2">
                <button type="button" class="btn btn-secondary btn-sm px-3" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary btn-sm px-3 animate-btn" id="btnConfirmImport" onclick="confirmImport()" disabled>Xác nhận Import</button>
            </div>
        </div>
    </div>
</div>



@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
    <script src="~/js/app-common.js" asp-append-version="true"></script>
    <script src="~/js/monhoc.js" asp-append-version="true"></script>
}
