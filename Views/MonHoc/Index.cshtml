@model List<DMS_Examify.Models.MonHoc>
@{
    ViewData["Title"] = "Quản lý Môn học";
    ViewData["Subtitle"] = "Thêm, sửa, xóa môn học";
}

<div class="row g-4">
    <!-- Form nhập liệu -->
    <div class="col-md-5 animate-in animate-in-delay-1">
        <div class="card">
            <div class="card-header">
                <span><i class="bi bi-pencil me-2"></i>Thông tin Môn học</span>
            </div>
            <div class="card-body">
                <form id="formMonHoc">
                    <div class="mb-3">
                        <label class="form-label">Mã môn học</label>
                        <input type="text" class="form-control" id="txtMaMH" placeholder="VD: MH001" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Tên môn học</label>
                        <input type="text" class="form-control" id="txtTenMH" placeholder="Nhập tên môn học" />
                    </div>

                    <div class="action-toolbar">
                        <button type="button" class="btn btn-primary" onclick="themMonHoc()">
                            <i class="bi bi-plus-lg"></i> Thêm
                        </button>
                        <button type="button" class="btn btn-danger" onclick="xoaMonHoc()">
                            <i class="bi bi-trash"></i> Xóa
                        </button>
                        <button type="button" class="btn btn-warning" onclick="hieuChinhMonHoc()">
                            <i class="bi bi-pencil-square"></i> Hiệu chỉnh
                        </button>
                        <button type="button" class="btn btn-outline-secondary" onclick="phucHoiMonHoc()">
                            <i class="bi bi-arrow-counterclockwise"></i> Phục hồi
                        </button>
                        <button type="button" class="btn btn-info" onclick="timMonHoc()">
                            <i class="bi bi-search"></i> Tìm
                        </button>
                        <button type="button" class="btn btn-success" onclick="ghiMonHoc()">
                            <i class="bi bi-floppy"></i> Ghi
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Bảng danh sách -->
    <div class="col-md-7 animate-in animate-in-delay-2">
        <div class="card">
            <div class="card-header">
                <span><i class="bi bi-list-ul me-2"></i>Danh sách Môn học</span>
                <span class="badge bg-primary">@Model.Count môn</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover" id="tableMonHoc">
                        <thead>
                            <tr>
                                <th style="width:50px">STT</th>
                                <th>Mã MH</th>
                                <th>Tên môn học</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Count; i++)
                            {
                                <tr onclick="chonMonHoc(this, '@Model[i].MaMH', '@Model[i].TenMH')" style="cursor:pointer;">
                                    <td>@(i + 1)</td>
                                    <td><strong>@Model[i].MaMH</strong></td>
                                    <td>@Model[i].TenMH</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (Model.Count == 0)
                {
                    <div class="empty-state">
                        <i class="bi bi-inbox"></i>
                        <p>Chưa có môn học nào</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let selectedRow = null;

        function chonMonHoc(row, maMH, tenMH) {
            // Deselect previous
            document.querySelectorAll('#tableMonHoc tbody tr').forEach(r => r.classList.remove('selected'));
            row.classList.add('selected');
            selectedRow = row;
            document.getElementById('txtMaMH').value = maMH;
            document.getElementById('txtTenMH').value = tenMH;
        }

        function themMonHoc() {
            document.getElementById('txtMaMH').value = '';
            document.getElementById('txtTenMH').value = '';
            document.getElementById('txtMaMH').focus();
            selectedRow = null;
        }

        function xoaMonHoc() {
            if (selectedRow) {
                if (confirm('Bạn có chắc muốn xóa môn học này?')) {
                    selectedRow.remove();
                    document.getElementById('txtMaMH').value = '';
                    document.getElementById('txtTenMH').value = '';
                    selectedRow = null;
                }
            } else {
                alert('Vui lòng chọn một môn học để xóa.');
            }
        }

        function hieuChinhMonHoc() {
            if (selectedRow) {
                const cells = selectedRow.cells;
                cells[1].innerHTML = '<strong>' + document.getElementById('txtMaMH').value + '</strong>';
                cells[2].textContent = document.getElementById('txtTenMH').value;
                alert('Đã hiệu chỉnh thành công!');
            } else {
                alert('Vui lòng chọn một môn học để hiệu chỉnh.');
            }
        }

        function phucHoiMonHoc() {
            document.getElementById('txtMaMH').value = '';
            document.getElementById('txtTenMH').value = '';
            selectedRow = null;
            document.querySelectorAll('#tableMonHoc tbody tr').forEach(r => r.classList.remove('selected'));
        }

        function timMonHoc() {
            const keyword = prompt('Nhập từ khóa tìm kiếm:');
            if (keyword) {
                const rows = document.querySelectorAll('#tableMonHoc tbody tr');
                rows.forEach(row => {
                    const text = row.textContent.toLowerCase();
                    row.style.display = text.includes(keyword.toLowerCase()) ? '' : 'none';
                });
            }
        }

        function ghiMonHoc() {
            const maMH = document.getElementById('txtMaMH').value;
            const tenMH = document.getElementById('txtTenMH').value;
            if (!maMH || !tenMH) {
                alert('Vui lòng nhập đầy đủ thông tin.');
                return;
            }
            if (!selectedRow) {
                // Add new row
                const tbody = document.querySelector('#tableMonHoc tbody');
                const rowCount = tbody.rows.length + 1;
                const newRow = tbody.insertRow();
                newRow.onclick = function () { chonMonHoc(this, maMH, tenMH); };
                newRow.style.cursor = 'pointer';
                newRow.innerHTML = `<td>${rowCount}</td><td><strong>${maMH}</strong></td><td>${tenMH}</td>`;
            }
            alert('Đã ghi thành công!');
        }
    </script>
}
