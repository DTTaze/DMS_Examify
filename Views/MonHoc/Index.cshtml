@model List<DMS_Examify.Models.MonHoc>

<div class="row g-4">
    <!-- FORM -->
    <div class="col-md-5">
        <div class="card">
            <div class="card-header">Thông tin Môn học</div>
            <div class="card-body">

                <div class="mb-3">
                    <label>Mã môn học</label>
                    <input id="txtMaMH" class="form-control" />
                </div>

                <div class="mb-3">
                    <label>Tên môn học</label>
                    <input id="txtTenMH" class="form-control" />
                </div>

                <div class="d-flex gap-2 flex-wrap">
                    <button type="button" class="btn btn-primary" onclick="them()">Thêm</button>
                    <button type="button" class="btn btn-warning" onclick="sua()">Sửa</button>
                    <button type="button" class="btn btn-danger" onclick="xoa()">Xóa</button>
                    <button type="button" class="btn btn-info" onclick="tim()">Tìm</button>
                    <button type="button" class="btn btn-success" onclick="ghi()">Ghi</button>
                    <button type="button" class="btn btn-secondary" onclick="resetForm()">Reset</button>
                </div>

            </div>
        </div>
    </div>

    <!-- TABLE -->
    <div class="col-md-7">
        <div class="card">
            <div class="card-header">
                Danh sách Môn học (@Model.Count)
            </div>

            <div class="card-body p-0">
                <table class="table table-hover" id="tbl">
                    <thead>
                        <tr>
                            <th>STT</th>
                            <th>Mã</th>
                            <th>Tên</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Count; i++)
                        {
                            <tr data-mamh="@Model[i].MaMH" data-tenmh="@Model[i].TenMH">
                                <td>@(i + 1)</td>
                                <td>@Model[i].MaMH</td>
                                <td>@Model[i].TenMH</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let newItems = [];
        let updatedItems = [];
        let deletedItems = [];
        let selectedRow = null;
        let historyStack = [];
        let tempId = -1;

        function pushState() {
            historyStack.push({
                html: document.querySelector("#tbl tbody").innerHTML,
                newItems: JSON.parse(JSON.stringify(newItems)),
                updatedItems: JSON.parse(JSON.stringify(updatedItems)),
                deletedItems: JSON.parse(JSON.stringify(deletedItems))
            });
        }

        function undo() {
            if (!historyStack.length) return alert("Không có gì để undo");

            const s = historyStack.pop();
            document.querySelector("#tbl tbody").innerHTML = s.html;
            newItems = s.newItems;
            updatedItems = s.updatedItems;
            deletedItems = s.deletedItems;

            bindRows();
            selectedRow = null;
        }

        function getForm() {
            return {
                MaMH: txtMaMH.value.trim(),
                TenMH: txtTenMH.value.trim()
            };
        }

        function fillForm(row) {
            txtMaMH.value = row.dataset.mamh;
            txtTenMH.value = row.dataset.tenmh;
        }

        function bindRows() {
            document.querySelectorAll("#tbl tbody tr").forEach(r => {
                r.onclick = () => {
                    document.querySelectorAll("#tbl tbody tr")
                        .forEach(x => x.classList.remove("table-active"));

                    r.classList.add("table-active");
                    selectedRow = r;
                    fillForm(r);
                };
            });
        }

        function them() {
            const d = getForm();
            if (!d.MaMH || !d.TenMH) return alert("Nhập đầy đủ");

            pushState();

            const id = tempId--;

            newItems.push({ Id: id, ...d });

            const row = document.querySelector("#tbl tbody").insertRow();
            row.dataset.id = id;
            row.dataset.mamh = d.MaMH;
            row.dataset.tenmh = d.TenMH;

            row.innerHTML = `
                    <td>...</td>
                    <td>${d.MaMH}</td>
                    <td>${d.TenMH}</td>
                `;

            bindRows();
            resetForm();
        }

        function sua() {
            if (!selectedRow) return alert("Chọn dòng");

            const d = getForm();
            const id = parseInt(selectedRow.dataset.id);

            pushState();

            selectedRow.innerHTML = `
                    <td>${id > 0 ? id : "..."}</td>
                    <td>${d.MaMH}</td>
                    <td>${d.TenMH}</td>
                `;

            selectedRow.dataset.mamh = d.MaMH;
            selectedRow.dataset.tenmh = d.TenMH;

            if (id < 0) {
                const i = newItems.findIndex(x => x.Id === id);
                if (i >= 0) newItems[i] = { Id: id, ...d };
            } else {
                updatedItems = updatedItems.filter(x => x.MaMH !== d.MaMH);
                updatedItems.push(d);
            }
        }

        function xoa() {
            if (!selectedRow) return alert("Chọn dòng");

            const id = parseInt(selectedRow.dataset.id);
            const maMH = selectedRow.dataset.mamh;

            pushState();

            if (id < 0) {
                newItems = newItems.filter(x => x.Id !== id);
            } else {
                updatedItems = updatedItems.filter(x => x.MaMH !== maMH);

                if (!deletedItems.some(x => x.MaMH === maMH)) {
                    deletedItems.push({ MaMH: maMH });
                }
            }

            selectedRow.remove();
            selectedRow = null;
            updateSTT();
        }

        async function ghi() {
            // DELETE
            for (const d of deletedItems) {
                await fetch(`/MonHoc/Delete?maMH=${d.MaMH}`, { method: "POST" });
            }

            // UPDATE
            for (const u of updatedItems) {
                await fetch(`/MonHoc/Update`, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(u)
                });
            }

            // INSERT
            for (const n of newItems) {
                await fetch(`/MonHoc/Insert`, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(n)
                });
            }

            alert("Lưu xong");
            location.reload();
        }

        function updateSTT() {
            const rows = document.querySelectorAll("#tbl tbody tr");
            rows.forEach((r, i) => {
                r.cells[0].textContent = i + 1;
            });
        }

        function resetForm() {
            txtMaMH.value = "";
            txtTenMH.value = "";
            selectedRow = null;
        }

        function tim() {
            const k = prompt("Nhập từ khóa");
            if (!k) return;

            fetch(`/MonHoc/Search?keyword=${k}`)
                .then(r => r.json())
                .then(data => {
                    const tbody = document.querySelector("#tbl tbody");
                    tbody.innerHTML = "";

                    data.forEach((x, i) => {
                        const row = tbody.insertRow();

                        row.dataset.id = x.maMH;
                        row.dataset.mamh = x.maMH;
                        row.dataset.tenmh = x.tenMH;

                        row.innerHTML = `
                                <td>${i + 1}</td>
                                <td>${x.maMH}</td>
                                <td>${x.tenMH}</td>
                            `;
                    });

                    bindRows();
                });
        }

        window.onload = bindRows;
    </script>
}