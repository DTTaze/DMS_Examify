@model List<DMS_Examify.Models.GiaoVien>

@{
    ViewData["Title"] = "Quản lý Giáo viên";
    ViewData["Subtitle"] = "Danh mục Giáo viên";
}

@section Styles {
    <link rel="stylesheet" href="~/css/giaovien.css" asp-append-version="true" />
}

<div class="row g-4">
    <!-- FORM -->
    <div class="col-12 mb-4">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-white border-bottom fw-bold py-3">Thông tin Giáo viên</div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-4">
                        <label class="form-label fw-medium">Mã giáo viên <span class="text-danger">*</span></label>
                        <input id="txtMaGV" class="form-control text-uppercase shadow-none" placeholder="Nhập mã giáo viên..." maxlength="8" />
                        <span id="errMaGV" class="text-danger small mt-1 d-block"></span>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-medium">Họ <span class="text-danger">*</span></label>
                        <input id="txtHoGV" class="form-control shadow-none" placeholder="Nhập họ..." maxlength="40" />
                        <span id="errHoGV" class="text-danger small mt-1 d-block"></span>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-medium">Tên <span class="text-danger">*</span></label>
                        <input id="txtTenGV" class="form-control shadow-none" placeholder="Nhập tên..." maxlength="10" />
                        <span id="errTenGV" class="text-danger small mt-1 d-block"></span>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-4">
                        <label class="form-label fw-medium">Số điện thoại liên lạc</label>
                        <input id="txtSoDTLL" class="form-control shadow-none" placeholder="Nhập số điện thoại..." maxlength="15" />
                        <span id="errSoDTLL" class="text-danger small mt-1 d-block"></span>
                    </div>
                    <div class="col-md-8">
                        <label class="form-label fw-medium">Địa chỉ</label>
                        <input id="txtDiaChiGV" class="form-control shadow-none" placeholder="Nhập địa chỉ..." maxlength="50" />
                        <span id="errDiaChiGV" class="text-danger small mt-1 d-block"></span>
                    </div>
                </div>

                <div class="d-flex gap-2 flex-wrap mt-2">
                    <span id="wrapThemGV" class="d-inline-block">
                        <button type="button" class="btn btn-primary px-4 animate-btn" id="btnThemGV" onclick="themGV()" disabled>
                            <i class="bi bi-plus-lg me-1"></i> Thêm
                        </button>
                    </span>
                    <span id="wrapSuaGV" class="d-inline-block">
                        <button type="button" class="btn btn-warning px-4 text-white animate-btn" id="btnSuaGV" onclick="hieuChinhGV()" disabled>
                            <i class="bi bi-pencil-square me-1"></i> Sửa
                        </button>
                    </span>
                    <button type="button" class="btn btn-secondary px-4 animate-btn" onclick="resetGiaoVienForm()">
                        <i class="bi bi-arrow-repeat me-1"></i> Đặt lại
                    </button>
                    <div class="vr mx-2 d-none d-md-block"></div>
                    <button type="button" class="btn btn-outline-info animate-btn" id="btnUndoGV" onclick="undoGV()" disabled>
                        <i class="bi bi-arrow-counterclockwise"></i> Undo
                    </button>
                    <button type="button" class="btn btn-outline-info animate-btn" id="btnRedoGV" onclick="redoGV()" disabled>
                        <i class="bi bi-arrow-clockwise"></i> Redo
                    </button>
                    <span id="wrapGhiGV" class="d-inline-block ms-auto mt-2 mt-md-0">
                        <button type="button" class="btn btn-success animate-btn px-4" id="btnGhiGV" onclick="ghiGV()" disabled>
                            <i class="bi bi-cloud-arrow-up me-1"></i> Ghi (Lưu CSDL)
                        </button>
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- TABLE -->
    <div class="col-12">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header d-flex justify-content-between align-items-center py-2">
                <span>Danh sách Giáo viên (<span id="lblCount">@Model.Count</span>)</span>
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-outline-success btn-sm animate-btn text-nowrap" onclick="exportExcel()" title="Xuất Excel">
                        <i class="bi bi-file-earmark-excel"></i> Xuất Excel
                    </button>
                    <button type="button" class="btn btn-outline-primary btn-sm animate-btn text-nowrap" onclick="openImportModal()" title="Nhập dữ liệu từ file Excel">
                        <i class="bi bi-file-earmark-arrow-up"></i> Nhập Excel
                    </button>
                    <div class="input-group input-group-sm mb-0" style="width: 250px;">
                        <span class="input-group-text bg-white border-end-0 text-secondary"><i class="bi bi-search"></i></span>
                        <input id="txtSearchGV" class="form-control border-start-0 shadow-none ps-0" placeholder="Tìm kiếm mã hoặc tên..." />
                    </div>
                </div>
            </div>

            <div class="card-body p-0 table-responsive border rounded-3 mb-0" style="max-height: 480px; overflow-y: auto;">
                <table class="table table-hover align-middle mb-0" id="tbl">
                    <thead class="table-light sticky-top">
                        <tr>
                            <th>Mã GV</th>
                            <th>Họ</th>
                            <th>Tên</th>
                            <th>Số ĐT</th>
                            <th>Địa chỉ</th>
                            <th class="text-center" style="width: 100px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody id="gvTable">
                        @foreach (var gv in Model)
                        {
                            <tr data-magv="@gv.MaGV" data-ho="@gv.Ho" data-ten="@gv.Ten" data-sdt="@gv.SoDTLL" data-diachi="@gv.DiaChi"
                                data-original-ho="@gv.Ho" data-original-ten="@gv.Ten" data-original-sdt="@gv.SoDTLL" data-original-diachi="@gv.DiaChi"
                                data-id="@gv.MaGV">
                                <td><span class="badge bg-light text-secondary border border-light">@gv.MaGV</span></td>
                                <td class="fw-semibold">@gv.Ho</td>
                                <td class="fw-semibold">@gv.Ten</td>
                                <td>@gv.SoDTLL</td>
                                <td>@gv.DiaChi</td>
                                <td class="text-center">
                                    <div class="d-flex gap-2 justify-content-center">
                                        <button type="button" class="btn btn-link text-warning p-0 btn-edit" title="Hiệu chỉnh"><i class="bi bi-pencil-square fs-5"></i></button>
                                        <button type="button" class="btn btn-link text-danger p-0 btn-delete" title="Xóa"><i class="bi bi-trash fs-5"></i></button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            
            <div class="card-footer d-flex justify-content-between align-items-center py-2 bg-light border-top-0">
                <div class="d-flex align-items-center gap-2">
                    <span class="small text-secondary fw-medium" id="lblPaginationSummary">Hiển thị từ 0 đến 0 trong tổng số 0 dòng</span>
                    <select class="form-select form-select-sm shadow-none" id="selectPageSize" style="width: 80px;" onchange="changePageSize(this.value)">
                        <option value="5">5</option>
                        <option value="10" selected>10</option>
                        <option value="20">20</option>
                        <option value="50">50</option>
                    </select>
                    <span class="small text-secondary fw-medium">dòng/trang</span>
                </div>
                <nav aria-label="Page navigation">
                    <ul class="pagination pagination-sm mb-0" id="ulPagination">
                        <!-- Pagination links injected here -->
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>

<!-- Custom Dialog Modal (Info / Confirm / Warning) -->
<div class="modal fade" id="customModal" tabindex="-1" aria-labelledby="customModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-3">
            <div class="modal-header border-0 bg-light py-3">
                <h5 class="modal-title d-flex align-items-center gap-2 fw-semibold" id="customModalLabel">
                    <i id="customModalIcon" class="bi fs-4"></i>
                    <span id="customModalTitle">Thông báo</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-4 fs-6 text-dark" id="customModalMessage">
                Nội dung thông báo ở đây.
            </div>
            <div class="modal-footer border-0 bg-light py-2">
                <button type="button" class="btn btn-secondary btn-sm px-3" id="btnCustomModalCancel" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary btn-sm px-3" id="btnCustomModalOk">Xác nhận</button>
            </div>
        </div>
    </div>
</div>

<!-- Import Excel Modal -->
<div class="modal fade" id="importModal" tabindex="-1" aria-labelledby="importModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content border-0 shadow-lg rounded-3">
            <div class="modal-header border-0 bg-light py-3">
                <h5 class="modal-title d-flex align-items-center gap-2 fw-semibold" id="importModalLabel">
                    <i class="bi bi-file-earmark-excel-fill text-success fs-4"></i>
                    <span>Import Giáo viên từ Excel</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-4">
                <div class="mb-3 d-flex justify-content-between align-items-center bg-light p-3 rounded-3 border border-dashed">
                    <div>
                        <span class="fw-medium text-secondary">Tải file cấu trúc mẫu (.xlsx):</span>
                        <p class="mb-0 text-muted small">File gồm 5 cột: Mã GV, Họ, Tên, Số ĐT, Địa chỉ</p>
                    </div>
                    <button type="button" class="btn btn-outline-success btn-sm px-3 animate-btn" onclick="downloadTemplate()">
                        <i class="bi bi-download"></i> Tải file mẫu
                    </button>
                </div>
                
                <div class="mb-4">
                    <label for="importFile" class="form-label fw-medium">Chọn file Excel (.xlsx, .xls)</label>
                    <input type="file" class="form-control shadow-none" id="importFile" accept=".xlsx, .xls" onchange="handleFileSelect(event)" />
                    <div id="importFileFeedback" class="text-danger small mt-1"></div>
                </div>

                <div id="importPreviewSection" style="display: none;">
                    <hr class="my-4 text-muted opacity-25" />
                    <h6 class="fw-semibold mb-3 d-flex justify-content-between align-items-center">
                        <span class="text-dark">Xem trước dữ liệu nhập</span>
                        <span id="importSummary" class="badge bg-secondary rounded-pill px-3 py-1.5">...</span>
                    </h6>
                    <div class="table-responsive border rounded-3" style="max-height: 280px; overflow-y: auto;">
                        <table class="table table-sm table-bordered table-hover align-middle mb-0" id="tblImportPreview">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th class="text-center" style="width: 50px;">STT</th>
                                    <th style="width: 120px;">Mã GV</th>
                                    <th style="width: 150px;">Họ</th>
                                    <th style="width: 100px;">Tên</th>
                                    <th style="width: 140px;">Số điện thoại</th>
                                    <th style="min-width: 150px;">Địa chỉ</th>
                                    <th style="width: 180px;">Trạng thái</th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- Preview rows injected here dynamically -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 bg-light py-2">
                <button type="button" class="btn btn-secondary btn-sm px-3" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary btn-sm px-3 animate-btn" id="btnConfirmImport" onclick="confirmImport()" disabled>Xác nhận Import</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
    <script src="~/js/app-common.js" asp-append-version="true"></script>
    <script src="~/js/giaovien.js" asp-append-version="true"></script>
}
