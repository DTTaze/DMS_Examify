@model List<DMS_Examify.Models.GiaoVien>
@{
    ViewData["Title"] = "Quản lý Giáo viên";
    ViewData["Subtitle"] = "Thêm, sửa, xóa giáo viên";
}

<div class="row g-4">
    <!-- Form nhập -->
    <div class="col-md-5 animate-in animate-in-delay-1">
        <div class="card">
            <div class="card-header">
                <span><i class="bi bi-person-badge me-2"></i>Thông tin Giáo viên</span>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label">Mã giáo viên</label>
                    <input type="text" class="form-control" id="txtMaGV" placeholder="VD: GV001" />
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Họ</label>
                        <input type="text" class="form-control" id="txtHoGV" placeholder="Trần Minh" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Tên</label>
                        <input type="text" class="form-control" id="txtTenGV" placeholder="Tuấn" />
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Số ĐT liên lạc</label>
                    <input type="text" class="form-control" id="txtSoDTLL" placeholder="0901234567" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Địa chỉ</label>
                    <input type="text" class="form-control" id="txtDiaChiGV" placeholder="Nhập địa chỉ" />
                </div>

                <div class="action-toolbar">
                    <button type="button" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Thêm</button>
                    <button type="button" class="btn btn-danger"><i class="bi bi-trash"></i> Xóa</button>
                    <button type="button" class="btn btn-warning"><i class="bi bi-pencil-square"></i> Hiệu chỉnh</button>
                    <button type="button" class="btn btn-outline-secondary"><i class="bi bi-arrow-counterclockwise"></i> Phục hồi</button>
                    <button type="button" class="btn btn-info"><i class="bi bi-search"></i> Tìm</button>
                    <button type="button" class="btn btn-success"><i class="bi bi-floppy"></i> Ghi</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Bảng danh sách -->
    <div class="col-md-7 animate-in animate-in-delay-2">
        <div class="card">
            <div class="card-header">
                <span><i class="bi bi-list-ul me-2"></i>Danh sách Giáo viên</span>
                <span class="badge bg-primary">@Model.Count GV</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th style="width:45px">STT</th>
                                <th>Mã GV</th>
                                <th>Họ</th>
                                <th>Tên</th>
                                <th>Số ĐT</th>
                                <th>Địa chỉ</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Count; i++)
                            {
                                var gv = Model[i];
                                <tr style="cursor:pointer;" onclick="chonGV(this, '@gv.MaGV', '@gv.Ho', '@gv.Ten', '@gv.SoDTLL', '@gv.DiaChi')">
                                    <td>@(i + 1)</td>
                                    <td><strong>@gv.MaGV</strong></td>
                                    <td>@gv.Ho</td>
                                    <td>@gv.Ten</td>
                                    <td>@gv.SoDTLL</td>
                                    <td>@gv.DiaChi</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function chonGV(row, maGV, ho, ten, sdt, diaChi) {
            document.querySelectorAll('table tbody tr').forEach(r => r.classList.remove('selected'));
            row.classList.add('selected');
            document.getElementById('txtMaGV').value = maGV;
            document.getElementById('txtHoGV').value = ho;
            document.getElementById('txtTenGV').value = ten;
            document.getElementById('txtSoDTLL').value = sdt;
            document.getElementById('txtDiaChiGV').value = diaChi;
        }
    </script>
}
