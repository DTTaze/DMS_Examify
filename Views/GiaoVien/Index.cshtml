@model List<DMS_Examify.Models.GiaoVien>
@{
    ViewData["Title"] = "Quản lý Giáo viên";
    ViewData["Subtitle"] = "Thêm, sửa, xóa giáo viên";
}

<div class="row g-4">
    <!-- Form nhập -->
    <div class="col-md-5 animate-in animate-in-delay-1">
        <div class="card">
            <div class="card-header">
                <span><i class="bi bi-person-badge me-2"></i>Thông tin Giáo viên</span>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label">Mã giáo viên</label>
                    <input type="text" class="form-control" id="txtMaGV" placeholder="VD: GV001" />
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Họ</label>
                        <input type="text" class="form-control" id="txtHoGV" placeholder="Trần Minh" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Tên</label>
                        <input type="text" class="form-control" id="txtTenGV" placeholder="Tuấn" />
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Số ĐT liên lạc</label>
                    <input type="text" class="form-control" id="txtSoDTLL" placeholder="0901234567" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Địa chỉ</label>
                    <input type="text" class="form-control" id="txtDiaChiGV" placeholder="Nhập địa chỉ" />
                </div>

                <div class="action-toolbar">
                    <button type="button" class="btn btn-primary" onclick="themGV()"><i class="bi bi-plus-lg"></i> Thêm</button>
                    <button type="button" class="btn btn-danger" onclick="xoaGV()"><i class="bi bi-trash"></i> Xóa</button>
                    <button type="button" class="btn btn-warning" onclick="hieuChinhGV()"><i class="bi bi-pencil-square"></i> Hiệu chỉnh</button>
                    <button type="button" class="btn btn-outline-secondary" onclick="phucHoiGV()"><i class="bi bi-arrow-counterclockwise"></i> Phục hồi</button>
                    <button type="button" class="btn btn-info" onclick="timGV()"><i class="bi bi-search"></i> Tìm</button>
                    <button type="button" class="btn btn-success" onclick="ghiGV()"><i class="bi bi-floppy"></i> Ghi</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Bảng danh sách -->
    <div class="col-md-7 animate-in animate-in-delay-2">
        <div class="card">
            <div class="card-header">
                <span><i class="bi bi-list-ul me-2"></i>Danh sách Giáo viên</span>
                <span class="badge bg-primary">@Model.Count GV</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th style="width:45px">STT</th>
                                <th>Mã GV</th>
                                <th>Họ</th>
                                <th>Tên</th>
                                <th>Số ĐT</th>
                                <th>Địa chỉ</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Count; i++)
                            {
                                var gv = Model[i];
                                <tr style="cursor:pointer;" onclick="chonGV(this, '@gv.MaGV', '@gv.Ho', '@gv.Ten', '@gv.SoDTLL', '@gv.DiaChi')">
                                    <td>@(i + 1)</td>
                                    <td><strong>@gv.MaGV</strong></td>
                                    <td>@gv.Ho</td>
                                    <td>@gv.Ten</td>
                                    <td>@gv.SoDTLL</td>
                                    <td>@gv.DiaChi</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let selectedRowGV = null;

        function chonGV(row, maGV, ho, ten, sdt, diaChi) {
            document.querySelectorAll('table tbody tr').forEach(r => r.classList.remove('selected'));
            row.classList.add('selected');
            selectedRowGV = row;
            document.getElementById('txtMaGV').value = maGV;
            document.getElementById('txtHoGV').value = ho;
            document.getElementById('txtTenGV').value = ten;
            document.getElementById('txtSoDTLL').value = sdt;
            document.getElementById('txtDiaChiGV').value = diaChi;
        }

        function themGV() {
            selectedRowGV = null;
            document.getElementById('txtMaGV').value = '';
            document.getElementById('txtHoGV').value = '';
            document.getElementById('txtTenGV').value = '';
            document.getElementById('txtSoDTLL').value = '';
            document.getElementById('txtDiaChiGV').value = '';
            document.getElementById('txtMaGV').focus();
        }

        function hieuChinhGV() {
            if (!selectedRowGV) {
                alert('Vui lòng chọn một giáo viên để hiệu chỉnh.');
                return;
            }
            selectedRowGV.cells[1].innerHTML = '<strong>' + document.getElementById('txtMaGV').value + '</strong>';
            selectedRowGV.cells[2].textContent = document.getElementById('txtHoGV').value;
            selectedRowGV.cells[3].textContent = document.getElementById('txtTenGV').value;
            selectedRowGV.cells[4].textContent = document.getElementById('txtSoDTLL').value;
            selectedRowGV.cells[5].textContent = document.getElementById('txtDiaChiGV').value;
        }

        function phucHoiGV() {
            selectedRowGV = null;
            document.querySelectorAll('table tbody tr').forEach(r => r.classList.remove('selected'));
            document.getElementById('txtMaGV').value = '';
            document.getElementById('txtHoGV').value = '';
            document.getElementById('txtTenGV').value = '';
            document.getElementById('txtSoDTLL').value = '';
            document.getElementById('txtDiaChiGV').value = '';
        }

        async function timGV() {
            const keyword = prompt('Nhập từ khóa tìm kiếm:');
            if (keyword == null) return;

            const res = await fetch('/GiaoVien/Search?keyword=' + encodeURIComponent(keyword));
            if (!res.ok) { alert('Tìm kiếm thất bại'); return; }
            const ds = await res.json();

            const tbody = document.querySelector('table tbody');
            tbody.innerHTML = '';
            ds.forEach((item, idx) => {
                const row = tbody.insertRow();
                row.style.cursor = 'pointer';
                row.onclick = () => chonGV(row, item.maGV, item.ho, item.ten, item.soDTLL, item.diaChi);
                row.innerHTML = `<td>${idx + 1}</td><td><strong>${item.maGV}</strong></td><td>${item.ho}</td><td>${item.ten}</td><td>${item.soDTLL}</td><td>${item.diaChi}</td>`;
            });
        }

        async function ghiGV() {
            const model = {
                MaGV: document.getElementById('txtMaGV').value.trim(),
                Ho: document.getElementById('txtHoGV').value.trim(),
                Ten: document.getElementById('txtTenGV').value.trim(),
                SoDTLL: document.getElementById('txtSoDTLL').value.trim(),
                DiaChi: document.getElementById('txtDiaChiGV').value.trim()
            };
            if (!model.MaGV || !model.Ho || !model.Ten) {
                alert('Thông tin chưa đầy đủ');
                return;
            }
            const url = selectedRowGV ? '/GiaoVien/Update' : '/GiaoVien/Insert';
            const res = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(model) });
            if (res.ok) {
                alert('Ghi thành công');
                location.reload();
            } else {
                const msg = await res.text();
                alert('Lỗi: ' + msg);
            }
        }

        async function xoaGV() {
            if (!selectedRowGV) { alert('Chọn giáo viên cần xóa'); return; }
            if (!confirm('Xác nhận xóa?')) return;
            const maGV = document.getElementById('txtMaGV').value;
            const res = await fetch('/GiaoVien/Delete?maGV=' + encodeURIComponent(maGV), { method: 'POST' });
            if (res.ok) { alert('Xóa thành công'); location.reload(); } else { alert('Xóa thất bại'); }
        }
    </script>
}
