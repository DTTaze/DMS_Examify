@model List<DMS_Examify.Models.GiaoVien>
@{ ViewData["Title"] = "Quản lý Giáo viên"; }

  <div class="row g-4">
    <!-- FORM -->
    <div class="col-md-5 animate-in animate-in-delay-1">
      <div class="card">
        <div class="card-header">
          <span
            ><i class="bi bi-person-badge me-2"></i>Thông tin Giáo viên</span
          >
        </div>
        <div class="card-body">
          <div class="mb-3">
            <label class="form-label">Mã giáo viên</label>
            <input
              type="text"
              class="form-control"
              id="txtMaGV"
              placeholder="VD: GV001"
            />
          </div>
          <div class="row g-3 mb-3">
            <div class="col-md-6">
              <label class="form-label">Họ</label>
              <input
                type="text"
                class="form-control"
                id="txtHoGV"
                placeholder="Trần Minh"
              />
            </div>
            <div class="col-md-6">
              <label class="form-label">Tên</label>
              <input
                type="text"
                class="form-control"
                id="txtTenGV"
                placeholder="Tuấn"
              />
            </div>
          </div>
          <div class="mb-3">
            <label class="form-label">Số ĐT liên lạc</label>
            <input
              type="text"
              class="form-control"
              id="txtSoDTLL"
              placeholder="0901234567"
            />
          </div>
          <div class="mb-3">
            <label class="form-label">Địa chỉ</label>
            <input
              type="text"
              class="form-control"
              id="txtDiaChiGV"
              placeholder="Nhập địa chỉ"
            />
          </div>

          <div class="action-toolbar">
            <button type="button" class="btn btn-primary" onclick="themGV()">
              <i class="bi bi-plus-lg"></i> Thêm
            </button>
            <button type="button" class="btn btn-danger" onclick="xoaGV()">
              <i class="bi bi-trash"></i> Xóa
            </button>
            <button
              type="button"
              class="btn btn-warning"
              onclick="hieuChinhGV()"
            >
              <i class="bi bi-pencil-square"></i> Hiệu chỉnh
            </button>
            <button
              type="button"
              class="btn btn-outline-secondary"
              onclick="phucHoiGV()"
            >
              <i class="bi bi-arrow-counterclockwise"></i> Phục hồi
            </button>
            <button type="button" class="btn btn-info" onclick="timGV()">
              <i class="bi bi-search"></i> Tìm
            </button>
            <button type="button" class="btn btn-success" onclick="ghiGV()">
              <i class="bi bi-floppy"></i> Ghi
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- TABLE -->
    <div class="col-md-7">
      <table class="table table-hover">
        <thead>
          <tr>
            <th>#</th>
            <th>Mã</th>
            <th>Họ</th>
            <th>Tên</th>
            <th>SĐT</th>
            <th>Địa chỉ</th>
          </tr>
        </thead>
        <tbody id="gvTable">
          @for (int i = 0; i < Model.Count; i++) { var gv = Model[i];
          <tr
            data-id="@gv.MaGV"
            data-magv="@gv.MaGV"
            data-ho="@gv.Ho"
            data-ten="@gv.Ten"
            data-sdt="@gv.SoDTLL"
            data-diachi="@gv.DiaChi"
            onclick="
              chonGV(
                this,
                '@gv.MaGV',
                '@gv.Ho',
                '@gv.Ten',
                '@gv.SoDTLL',
                '@gv.DiaChi',
              )
            "
          >
            <td>@(i + 1)</td>
            <td>@gv.MaGV</td>
            <td>@gv.Ho</td>
            <td>@gv.Ten</td>
            <td>@gv.SoDTLL</td>
            <td>@gv.DiaChi</td>
          </tr>
          }
        </tbody>
      </table>
    </div>
  </div>

  @section Scripts {
  <script>
    let newItems = [];
    let updatedItems = [];
    let deletedItems = [];
    let selectedRow = null;
    let historyStack = [];
    let tempId = -1;

    // ================= SAVE STATE (UNDO) =================
    function pushState() {
      historyStack.push({
        html: document.getElementById("gvTable").innerHTML,
        newItems: JSON.parse(JSON.stringify(newItems)),
        updatedItems: JSON.parse(JSON.stringify(updatedItems)),
        deletedItems: JSON.parse(JSON.stringify(deletedItems)),
      });
    }

    // ================= UNDO =================
    function undo() {
      if (!historyStack.length) return alert("Không có gì để undo");

      const s = historyStack.pop();
      document.getElementById("gvTable").innerHTML = s.html;
      newItems = s.newItems;
      updatedItems = s.updatedItems;
      deletedItems = s.deletedItems;

      bindRows();
      selectedRow = null;
    }

    function phucHoiGV() {
    if (!historyStack.length) {
        alert("Không có gì để phục hồi");
        return;
    }

    const s = historyStack.pop();

    // restore UI
    document.getElementById("gvTable").innerHTML = s.html;

    // restore data
    newItems = s.newItems;
    updatedItems = s.updatedItems;
    deletedItems = s.deletedItems;

    // bind lại sự kiện click
    bindRows();

    // reset trạng thái chọn
    selectedRow = null;

    // clear form (giống BoDe)
    txtMaGV.value = '';
    txtHoGV.value = '';
    txtTenGV.value = '';
    txtSoDTLL.value = '';
    txtDiaChiGV.value = '';
}

    // ================= FORM =================
    function getForm() {
      return {
        MaGV: txtMaGV.value.trim(),
        Ho: txtHoGV.value.trim(),
        Ten: txtTenGV.value.trim(),
        SoDTLL: txtSoDTLL.value.trim(),
        DiaChi: txtDiaChiGV.value.trim(),
      };
    }

    function fillForm(row) {
      txtMaGV.value = row.dataset.magv;
      txtHoGV.value = row.dataset.ho;
      txtTenGV.value = row.dataset.ten;
      txtSoDTLL.value = row.dataset.sdt;
      txtDiaChiGV.value = row.dataset.diachi;
    }

    // ================= BIND ROW =================
    function bindRows() {
      document.querySelectorAll("#gvTable tr").forEach((r) => {
        r.onclick = () => {
          document
            .querySelectorAll("#gvTable tr")
            .forEach((x) => x.classList.remove("table-active"));
          r.classList.add("table-active");
          selectedRow = r;
          fillForm(r);
        };
      });
    }

    // ================= ADD =================
    function themGV() {
      const d = getForm();
      if (!d.MaGV || !d.Ho || !d.Ten) return alert("Thiếu dữ liệu");

      pushState();

      const id = tempId--;
      newItems.push({ Id: id, ...d });

      const row = document.getElementById("gvTable").insertRow();
      row.dataset.id = id;
      row.dataset.magv = d.MaGV;
      row.dataset.ho = d.Ho;
      row.dataset.ten = d.Ten;
      row.dataset.sdt = d.SoDTLL;
      row.dataset.diachi = d.DiaChi;

      row.innerHTML = `
        <td>...</td>
        <td>${d.MaGV}</td>
        <td>${d.Ho}</td>
        <td>${d.Ten}</td>
        <td>${d.SoDTLL}</td>
        <td>${d.DiaChi}</td>
    `;

      bindRows();
    }

    // ================= EDIT =================
    function hieuChinhGV() {
      if (!selectedRow) return alert("Chọn giáo viên");

      const d = getForm();

      if (!d.MaGV || !d.Ho || !d.Ten) {
        alert("Dữ liệu không hợp lệ (không được để trống)");
        return;
      }

      const id = parseInt(selectedRow.dataset.id || 0);

      pushState();

      selectedRow.innerHTML = `
<td>${id > 0 ? id : "..."}</td>
<td>${d.MaGV}</td>
<td>${d.Ho}</td>
<td>${d.Ten}</td>
<td>${d.SoDTLL}</td>
<td>${d.DiaChi}</td>
`;

      Object.assign(selectedRow.dataset, {
        magv: d.MaGV,
        ho: d.Ho,
        ten: d.Ten,
        sdt: d.SoDTLL,
        diachi: d.DiaChi,
      });

      if (id < 0) {
        const i = newItems.findIndex((x) => x.Id === id);
        if (i >= 0) newItems[i] = { Id: id, ...d };
      } else {
        updatedItems = updatedItems.filter(
          (x) => x.MaGV !== selectedRow.dataset.magv,
        );
        updatedItems.push(d);
      }
    }

    // ================= DELETE =================
    function xoaGV() {
      if (!selectedRow) return alert("Chọn dòng");

      const id = parseInt(selectedRow.dataset.id || 0);
      const maGV = selectedRow.dataset.magv;

      pushState();

      if (id < 0) {
        newItems = newItems.filter((x) => x.Id !== id);
      } else {
        updatedItems = updatedItems.filter((x) => x.MaGV !== maGV);
        if (!deletedItems.includes(maGV)) deletedItems.push(maGV);
      }

      selectedRow.remove();
      selectedRow = null;
    }

    // ================= SAVE ALL =================
    async function ghiGV() {
      // DELETE
      for (const ma of deletedItems) {
        await fetch(`/GiaoVien/Delete?maGV=${ma}`, { method: "POST" });
      }

      // UPDATE
      for (const u of updatedItems) {
        await fetch(`/GiaoVien/Update`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(u),
        });
      }

      // INSERT
      for (const n of newItems) {
        await fetch(`/GiaoVien/Insert`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(n),
        });
      }

      alert("Lưu thành công");
      location.reload();
    }

    // ================= SEARCH =================
    async function timGV() {
      const k = prompt("Nhập từ khóa");
      if (!k) return;

      const res = await fetch(`/GiaoVien/Search?keyword=${k}`);
      const data = await res.json();

      const tbody = document.getElementById("gvTable");
      tbody.innerHTML = "";

      data.forEach((x, i) => {
        const row = tbody.insertRow();

        row.dataset.id = x.maGV;
        row.dataset.magv = x.maGV;
        row.dataset.ho = x.ho;
        row.dataset.ten = x.ten;
        row.dataset.sdt = x.soDTLL;
        row.dataset.diachi = x.diaChi;

        row.innerHTML = `
<td>${i + 1}</td>
<td>${x.maGV}</td>
<td>${x.ho}</td>
<td>${x.ten}</td>
<td>${x.soDTLL}</td>
<td>${x.diaChi}</td>
`;
      });

      bindRows();
    }

    // ================= INIT =================
    window.onload = bindRows;
  </script>
  }</DMS_Examify.Models.GiaoVien
>
