@model List<DMS_Examify.Models.Lop>

@{
    ViewData["Title"] = "Quản lý Sinh viên";
    ViewData["Subtitle"] = "Quản lý Lớp & Sinh viên";
}

@section Styles {
    <link rel="stylesheet" href="~/css/sinhvien.css" asp-append-version="true" />
}

<div class="row g-4">
    <!-- ============================================ -->
    <!-- SECTION: LỚP HỌC                             -->
    <!-- ============================================ -->
    
    <!-- LỚP HỌC: FORM -->
    <div class="col-12 mb-1">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-white border-bottom fw-bold py-3">Thông tin Lớp học</div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-4">
                        <label class="form-label fw-medium">Mã lớp <span class="text-danger">*</span></label>
                        <input id="txtMaLop" class="form-control text-uppercase shadow-none" placeholder="Nhập mã lớp..." maxlength="8" />
                        <span id="errMaLop" class="text-danger small mt-1 d-block"></span>
                    </div>
                    <div class="col-md-8">
                        <label class="form-label fw-medium">Tên lớp <span class="text-danger">*</span></label>
                        <input id="txtTenLop" class="form-control shadow-none" placeholder="Nhập tên lớp..." maxlength="40" />
                        <span id="errTenLop" class="text-danger small mt-1 d-block"></span>
                    </div>
                </div>

                <div class="d-flex gap-2 flex-wrap mt-2">
                    <span id="wrapThemLop" class="d-inline-block">
                        <button type="button" class="btn btn-primary px-4 animate-btn" id="btnThemLop" onclick="themLop()" disabled>
                            <i class="bi bi-plus-lg me-1"></i> Thêm
                        </button>
                    </span>
                    <span id="wrapSuaLop" class="d-inline-block">
                        <button type="button" class="btn btn-warning px-4 text-white animate-btn" id="btnSuaLop" onclick="suaLop()" disabled>
                            <i class="bi bi-pencil-square me-1"></i> Sửa
                        </button>
                    </span>
                    <button type="button" class="btn btn-secondary px-4 animate-btn" onclick="clickResetLop()">
                        <i class="bi bi-arrow-repeat me-1"></i> Đặt lại
                    </button>
                    <div class="vr mx-2 d-none d-md-block"></div>
                    <button type="button" class="btn btn-outline-info animate-btn" id="btnUndoLop" onclick="undoLop()" disabled>
                        <i class="bi bi-arrow-counterclockwise"></i> Undo
                    </button>
                    <button type="button" class="btn btn-outline-info animate-btn" id="btnRedoLop" onclick="redoLop()" disabled>
                        <i class="bi bi-arrow-clockwise"></i> Redo
                    </button>
                    <span id="wrapGhiLop" class="d-inline-block ms-auto">
                        <button type="button" class="btn btn-success animate-btn px-4" id="btnGhiLop" onclick="ghiLop()" disabled>
                            <i class="bi bi-cloud-arrow-up me-1"></i> Ghi (Lưu CSDL)
                        </button>
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- LỚP HỌC: DANH SÁCH -->
    <div class="col-12 mb-4">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header d-flex justify-content-between align-items-center py-2">
                <span>Danh sách Lớp (<span id="lblLopCount">@Model.Count</span>)</span>
                <div class="d-flex align-items-center gap-2">
                    <div class="input-group input-group-sm mb-0" style="width: 250px;">
                        <span class="input-group-text bg-white border-end-0 text-secondary"><i class="bi bi-search"></i></span>
                        <input id="txtSearchLop" class="form-control border-start-0 shadow-none ps-0" placeholder="Tìm kiếm mã hoặc tên lớp..." oninput="locLop()" />
                        <button class="btn btn-outline-secondary border-start-0 d-none" type="button" id="btnClearSearchLop" onclick="clearSearchLop()">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>
                </div>
            </div>
            
            <div class="card-body p-0 border rounded-3 mb-0 class-list-container" style="max-height: 400px; overflow-y: auto;">
                <div id="lopEmptyState" class="text-center py-4 text-muted small d-none">
                    <i class="bi bi-info-circle fs-5 d-block mb-2 text-secondary"></i>
                    Không tìm thấy lớp học nào phù hợp.
                </div>
                <ul class="list-group list-group-flush rounded-3" id="lopList">
                    @foreach (var lop in Model)
                    {
                        <li class="list-group-item list-group-item-action border-light" 
                            data-malop="@lop.MaLop" 
                            data-tenlop="@lop.TenLop"
                            data-original-tenlop="@lop.TenLop"
                            onclick="chonLop(this)">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="fw-semibold text-dark">@lop.TenLop</span>
                                    <span class="badge bg-light text-secondary border border-light ms-2">@lop.MaLop</span>
                                </div>
                                <div class="d-flex gap-2">
                                    <button type="button" class="btn btn-link p-0 text-warning" onclick="editLopClick(event, this.closest('li'))" title="Sửa">
                                        <i class="bi bi-pencil-square fs-5"></i>
                                    </button>
                                    <span class="d-inline-block" tabindex="0" title="@(lop.HasDependencies ? "Không thể xóa vì đã có dữ liệu liên quan" : "Xóa")">
                                        <button type="button" class="btn btn-link p-0 text-danger" onclick="deleteLopClick(event, this.closest('li'))" @(lop.HasDependencies ? "disabled style=pointer-events:none;" : "")>
                                            <i class="bi bi-trash fs-5"></i>
                                        </button>
                                    </span>
                                </div>
                            </div>
                        </li>
                    }
                </ul>
            </div>
            <div class="card-footer d-flex justify-content-between align-items-center py-2 bg-light border-top-0">
                <div class="d-flex align-items-center gap-2">
                    <span class="small text-secondary fw-medium" id="lblLopPaginationSummary">Hiển thị từ 0 đến 0 trong tổng số 0 dòng</span>
                    <select class="form-select form-select-sm shadow-none" id="selectLopPageSize" style="width: 80px;" onchange="changeLopPageSize(this.value)">
                        <option value="5" selected>5</option>
                        <option value="10">10</option>
                        <option value="20">20</option>
                        <option value="50">50</option>
                    </select>
                    <span class="small text-secondary fw-medium">dòng/trang</span>
                </div>
                <nav aria-label="Page navigation">
                    <ul class="pagination pagination-sm mb-0" id="ulLopPagination">
                        <!-- Pagination items injected here -->
                    </ul>
                </nav>
            </div>
        </div>
    </div>

    <!-- ============================================ -->
    <!-- SECTION: SINH VIÊN                           -->
    <!-- ============================================ -->

    <!-- SINH VIÊN: FORM -->
    <div class="col-12 mb-1">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-white border-bottom fw-bold py-3">
                Thông tin Sinh viên - <span id="currentLop" class="text-primary fw-normal">Chưa chọn lớp</span>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-4">
                        <label class="form-label fw-medium">Mã sinh viên <span class="text-danger">*</span></label>
                        <input id="txtMaSV" class="form-control text-uppercase shadow-none" placeholder="Nhập mã SV..." />
                        <span id="errMaSV" class="text-danger small mt-1 d-block"></span>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-medium">Họ đệm <span class="text-danger">*</span></label>
                        <input id="txtHo" class="form-control shadow-none" placeholder="Nhập họ đệm..." />
                        <span id="errHo" class="text-danger small mt-1 d-block"></span>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-medium">Tên <span class="text-danger">*</span></label>
                        <input id="txtTen" class="form-control shadow-none" placeholder="Nhập tên..." />
                        <span id="errTen" class="text-danger small mt-1 d-block"></span>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-4">
                        <label class="form-label fw-medium">Ngày sinh <span class="text-danger">*</span></label>
                        <input id="txtNgaySinh" type="date" class="form-control shadow-none" max="@DateTime.Now.ToString("yyyy-MM-dd")" />
                        <span id="errNgaySinh" class="text-danger small mt-1 d-block"></span>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-medium">Địa chỉ <span class="text-danger">*</span></label>
                        <input id="txtDiaChi" class="form-control shadow-none" placeholder="Nhập địa chỉ..." />
                        <span id="errDiaChi" class="text-danger small mt-1 d-block"></span>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-medium">Mật khẩu <span class="text-danger">*</span></label>
                        <input id="txtMatKhau" type="password" class="form-control shadow-none" placeholder="Nhập mật khẩu..." />
                        <span id="errMatKhau" class="text-danger small mt-1 d-block"></span>
                    </div>
                </div>

                <div class="d-flex gap-2 flex-wrap mt-2">
                    <span id="wrapThemSV" class="d-inline-block">
                        <button type="button" class="btn btn-primary px-4 animate-btn" id="btnThemSV" onclick="themSV()" disabled>
                            <i class="bi bi-plus-lg me-1"></i> Thêm
                        </button>
                    </span>
                    <span id="wrapSuaSV" class="d-inline-block">
                        <button type="button" class="btn btn-warning px-4 text-white animate-btn" id="btnSuaSV" onclick="suaSV()" disabled>
                            <i class="bi bi-pencil-square me-1"></i> Sửa
                        </button>
                    </span>
                    <button type="button" class="btn btn-secondary px-4 animate-btn" onclick="resetStudentForm()">
                        <i class="bi bi-arrow-repeat me-1"></i> Đặt lại
                    </button>
                    <div class="vr mx-2 d-none d-md-block"></div>
                    <button type="button" class="btn btn-outline-info animate-btn" id="btnUndoSV" onclick="undoSV()" disabled>
                        <i class="bi bi-arrow-counterclockwise"></i> Undo
                    </button>
                    <button type="button" class="btn btn-outline-info animate-btn" id="btnRedoSV" onclick="redoSV()" disabled>
                        <i class="bi bi-arrow-clockwise"></i> Redo
                    </button>
                    <span id="wrapGhiSV" class="d-inline-block ms-auto">
                        <button type="button" class="btn btn-success animate-btn px-4" id="btnGhiSV" onclick="ghiSV()" disabled>
                            <i class="bi bi-cloud-arrow-up me-1"></i> Ghi (Lưu CSDL)
                        </button>
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- SINH VIÊN: DANH SÁCH -->
    <div class="col-12">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header d-flex justify-content-between align-items-center py-2">
                <span>Danh sách Sinh viên (<span id="lblSVCount">0</span>)</span>
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-outline-success btn-sm animate-btn text-nowrap" id="btnExport" onclick="exportExcel()" title="Xuất Excel" disabled>
                        <i class="bi bi-file-earmark-excel"></i> Xuất Excel
                    </button>
                    <button type="button" class="btn btn-outline-primary btn-sm animate-btn text-nowrap" id="btnImport" onclick="openImportModal()" title="Nhập Excel" disabled>
                        <i class="bi bi-file-earmark-arrow-up"></i> Nhập Excel
                    </button>
                    <div class="input-group input-group-sm mb-0" style="width: 250px;">
                        <span class="input-group-text bg-white border-end-0 text-secondary"><i class="bi bi-search"></i></span>
                        <input id="txtSearchSV" class="form-control border-start-0 shadow-none ps-0" placeholder="Tìm kiếm sinh viên..." />
                    </div>
                </div>
            </div>

            <div class="card-body p-0 table-responsive border rounded-3 mb-0" style="max-height: 400px; overflow-y: auto;">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light sticky-top">
                        <tr>
                            <th>Mã SV</th>
                            <th>Họ</th>
                            <th>Tên</th>
                            <th>Ngày sinh</th>
                            <th>Địa chỉ</th>
                            <th class="text-center" style="width: 100px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody id="svTable">
                        <!-- Injected dynamically -->
                    </tbody>
                </table>
            </div>
            <div class="card-footer d-flex justify-content-between align-items-center py-2 bg-light border-top-0">
                <div class="d-flex align-items-center gap-2">
                    <span class="small text-secondary fw-medium" id="lblPaginationSummary">Hiển thị từ 0 đến 0 trong tổng số 0 dòng</span>
                    <select class="form-select form-select-sm shadow-none" id="selectPageSize" style="width: 80px;" onchange="changePageSize(this.value)">
                        <option value="5">5</option>
                        <option value="10" selected>10</option>
                        <option value="20">20</option>
                        <option value="50">50</option>
                    </select>
                    <span class="small text-secondary fw-medium">dòng/trang</span>
                </div>
                <nav aria-label="Page navigation">
                    <ul class="pagination pagination-sm mb-0" id="ulPagination">
                        <!-- Pagination links injected here -->
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>

<!-- Custom Dialog Modal (Info / Confirm / Warning) -->
<div class="modal fade" id="customModal" tabindex="-1" aria-labelledby="customModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-3">
            <div class="modal-header border-0 bg-light py-3">
                <h5 class="modal-title d-flex align-items-center gap-2 fw-semibold" id="customModalLabel">
                    <i id="customModalIcon" class="bi fs-4"></i>
                    <span id="customModalTitle">Thông báo</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-4 fs-6 text-dark" id="customModalMessage">
                Nội dung thông báo ở đây.
            </div>
            <div class="modal-footer border-0 bg-light py-2">
                <button type="button" class="btn btn-secondary btn-sm px-3" id="btnCustomModalCancel" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary btn-sm px-3" id="btnCustomModalOk">Xác nhận</button>
            </div>
        </div>
    </div>
</div>

<!-- Import Excel Modal -->
<div class="modal fade" id="importModal" tabindex="-1" aria-labelledby="importModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-3">
            <div class="modal-header border-0 bg-light py-3">
                <h5 class="modal-title d-flex align-items-center gap-2 fw-semibold" id="importModalLabel">
                    <i class="bi bi-file-earmark-excel-fill text-success fs-4"></i>
                    <span>Import Sinh viên từ Excel</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-4">
                <div class="mb-3 d-flex justify-content-between align-items-center bg-light p-3 rounded-3 border border-dashed">
                    <div>
                        <span class="fw-medium text-secondary">Tải file cấu trúc mẫu (.xlsx):</span>
                        <p class="mb-0 text-muted small">File gồm 6 cột: Mã SV, Họ, Tên, Ngày sinh, Địa chỉ, Mật khẩu</p>
                    </div>
                    <button type="button" class="btn btn-outline-success btn-sm px-3 animate-btn" onclick="downloadTemplate()">
                        <i class="bi bi-download"></i> Tải file mẫu
                    </button>
                </div>
                
                <div class="mb-4">
                    <label for="importFile" class="form-label fw-medium">Chọn file Excel (.xlsx, .xls)</label>
                    <input type="file" class="form-control shadow-none" id="importFile" accept=".xlsx, .xls" onchange="handleFileSelect(event)" />
                    <div id="importFileFeedback" class="text-danger small mt-1"></div>
                </div>

                <div id="importPreviewSection" style="display: none;">
                    <hr class="my-4 text-muted opacity-25" />
                    <h6 class="fw-semibold mb-3 d-flex justify-content-between align-items-center">
                        <span class="text-dark">Xem trước dữ liệu nhập</span>
                        <span id="importSummary" class="badge bg-secondary rounded-pill px-3 py-1.5">...</span>
                    </h6>
                    <div class="table-responsive border rounded-3" style="max-height: 280px; overflow-y: auto;">
                        <table class="table table-sm table-bordered table-hover align-middle mb-0" id="tblImportPreview">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th class="text-center" style="width: 50px;">STT</th>
                                    <th style="width: 150px;">Mã sinh viên</th>
                                    <th>Họ & Tên</th>
                                    <th style="width: 200px;">Trạng thái</th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- Preview rows injected here dynamically -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 bg-light py-2">
                <button type="button" class="btn btn-secondary btn-sm px-3" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary btn-sm px-3 animate-btn" id="btnConfirmImport" onclick="confirmImport()" disabled>Xác nhận Import</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
    <script src="~/js/app-common.js" asp-append-version="true"></script>
    <script src="~/js/sinhvien.js" asp-append-version="true"></script>
}
