@model List<DMS_Examify.Models.TaiKhoan>
@{
    ViewData["Title"] = "Tài khoản & Phân quyền";
    ViewData["Subtitle"] = "Tạo tài khoản và quản lý quyền hạn";
}

<div class="row g-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="col-12">
            <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> <strong>Tuyệt vời!</strong> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </div>
    }
    @if (ViewBag.ErrorMessage != null)
    {
        <div class="col-12">
            <div class="alert alert-danger" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @ViewBag.ErrorMessage
            </div>
        </div>
    }

    <!-- Form tạo tài khoản -->
    <div class="col-md-5 animate-in animate-in-delay-1">
        <div class="card">
            <div class="card-header">
                <span><i class="bi bi-person-plus me-2"></i>Tạo tài khoản mới</span>
            </div>
            <div class="card-body">
                <form asp-action="Create" asp-controller="TaiKhoan" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label for="MaGV" class="form-label">Mã Giáo Viên / PGV (MAGV)</label>
                        <input type="text" name="MaGV" id="MaGV" class="form-control" placeholder="VD: GV001"
                            required />
                    </div>

                    <div class="mb-3">
                        <div id="gvError" class="text-danger fw-bold mb-1" style="display:none; font-size:13px;"></div>
                        <label for="FullName" class="form-label">Họ tên Giáo viên</label>
                        <input type="text" id="FullName" class="form-control bg-light" placeholder="Họ tên sẽ tự động hiển thị" readonly />
                    </div>

                    <div class="mb-3">
                        <label for="LoginName" class="form-label">Tên đăng nhập (Login)</label>
                        <input type="text" name="LoginName" id="LoginName" class="form-control"
                            placeholder="VD: gv_tuan" required />
                    </div>

                    <div class="mb-3">
                        <label for="Password" class="form-label">Mật khẩu</label>
                        <input type="password" name="Password" id="Password" class="form-control"
                            placeholder="Nhập mật khẩu" required />
                    </div>

                    <div class="mb-3">
                        <label for="Role" class="form-label">Nhóm quyền</label>
                        <select name="Role" id="Role" class="form-select" @(ViewBag.Roles == null || ((List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Roles).Count == 0 ? "disabled" : "")>
                            @if (ViewBag.Roles != null && ((List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Roles).Count > 0)
                            {
                                foreach (var roleItem in (List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Roles)
                                {
                                    <option value="@roleItem.Value" selected="@(roleItem.Selected ? "selected" : null)">@roleItem.Text</option>
                                }
                            }
                            else
                            {
                                <option value="" disabled selected>Lỗi không tải được danh sách quyền</option>
                            }
                        </select>
                        <div style="font-size:11px; color:var(--text-muted); margin-top:4px;">
                            <i class="bi bi-info-circle"></i> Chỉ cho phép tạo tài khoản cho PGV và Giảng viên. Sinh
                            viên dùng tài khoản chung.
                        </div>
                    </div>

                    <button type="submit" class="btn btn-success w-100" style="padding:10px;">
                        <i class="bi bi-check-lg me-1"></i> Tạo tài khoản
                    </button>
                </form>
            </div>
        </div>

        <!-- Bảng phân quyền -->
        <div class="card mt-3">
            <div class="card-header">
                <span><i class="bi bi-shield-lock me-2"></i>Bảng phân quyền</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table" style="font-size:12px;">
                        <thead>
                            <tr>
                                <th>Chức năng</th>
                                <th class="text-center">PGV</th>
                                <th class="text-center">GV</th>
                                <th class="text-center">SV</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Quản lý Môn học</td>
                                <td class="text-center"><i class="bi bi-check-circle-fill text-success"></i></td>
                                <td class="text-center"><i class="bi bi-x-circle text-danger"></i></td>
                                <td class="text-center"><i class="bi bi-x-circle text-danger"></i></td>
                            </tr>
                            <tr>
                                <td>Quản lý Sinh viên</td>
                                <td class="text-center"><i class="bi bi-check-circle-fill text-success"></i></td>
                                <td class="text-center"><i class="bi bi-x-circle text-danger"></i></td>
                                <td class="text-center"><i class="bi bi-x-circle text-danger"></i></td>
                            </tr>
                            <tr>
                                <td>Quản lý Giáo viên</td>
                                <td class="text-center"><i class="bi bi-check-circle-fill text-success"></i></td>
                                <td class="text-center"><i class="bi bi-x-circle text-danger"></i></td>
                                <td class="text-center"><i class="bi bi-x-circle text-danger"></i></td>
                            </tr>
                            <tr>
                                <td>Nhập câu hỏi thi</td>
                                <td class="text-center"><i class="bi bi-check-circle-fill text-success"></i></td>
                                <td class="text-center"><i class="bi bi-check-circle-fill text-success"></i></td>
                                <td class="text-center"><i class="bi bi-x-circle text-danger"></i></td>
                            </tr>
                            <tr>
                                <td>Đăng ký thi</td>
                                <td class="text-center"><i class="bi bi-check-circle-fill text-success"></i></td>
                                <td class="text-center"><i class="bi bi-check-circle-fill text-success"></i></td>
                                <td class="text-center"><i class="bi bi-x-circle text-danger"></i></td>
                            </tr>
                            <tr>
                                <td>Thi</td>
                                <td class="text-center"><i class="bi bi-x-circle text-danger"></i></td>
                                <td class="text-center"><i class="bi bi-check-circle-fill text-success"
                                        title="Thi thử, không ghi điểm"></i></td>
                                <td class="text-center"><i class="bi bi-check-circle-fill text-success"></i></td>
                            </tr>
                            <tr>
                                <td>Xem kết quả</td>
                                <td class="text-center"><i class="bi bi-check-circle-fill text-success"></i></td>
                                <td class="text-center"><i class="bi bi-check-circle-fill text-success"></i></td>
                                <td class="text-center"><i class="bi bi-check-circle-fill text-success"></i></td>
                            </tr>
                            <tr>
                                <td>Bảng điểm</td>
                                <td class="text-center"><i class="bi bi-check-circle-fill text-success"></i></td>
                                <td class="text-center"><i class="bi bi-check-circle-fill text-success"></i></td>
                                <td class="text-center"><i class="bi bi-x-circle text-danger"></i></td>
                            </tr>
                            <tr>
                                <td>Tài khoản & Phân quyền</td>
                                <td class="text-center"><i class="bi bi-check-circle-fill text-success"></i></td>
                                <td class="text-center"><i class="bi bi-x-circle text-danger"></i></td>
                                <td class="text-center"><i class="bi bi-x-circle text-danger"></i></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Danh sách tài khoản -->
    <div class="col-md-7 animate-in animate-in-delay-2">
        <div class="card">
            <div class="card-header">
                <span><i class="bi bi-people me-2"></i>Danh sách tài khoản</span>
                <span class="badge bg-primary">@Model.Count tài khoản</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th style="width:45px">STT</th>
                                <th>Login</th>
                                <th>Họ tên</th>
                                <th>Nhóm quyền</th>
                                <th style="width:80px">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Count; i++)
                            {
                                var tk = Model[i];
                                var badgeClass = tk.NhomQuyen == "PGV" ? "badge-role-pgv" : tk.NhomQuyen == "Giangvien" ?
                                "badge-role-gv" : "badge-role-sv";
                                var nhomLabel = tk.NhomQuyen == "PGV" ? "PGV" : tk.NhomQuyen == "Giangvien" ? "Giảng viên" :
                                "Sinh viên";
                                <tr>
                                    <td>@(i + 1)</td>
                                    <td><strong>@tk.LoginName</strong></td>
                                    <td>@tk.HoTen</td>
                                    <td><span class="badge @badgeClass">@nhomLabel</span></td>
                                    <td>
                                        <button class="btn btn-outline-secondary btn-sm" title="Xóa">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            let timeout = null;
            $('#MaGV').on('input', function () {
                clearTimeout(timeout);
                var magv = $(this).val().trim();
                
                // Reset thông tin
                $('#FullName').val('');
                $('#gvError').hide().text('');

                if (magv.length === 0) return;

                // Chờ người dùng gõ xong 500ms thì mới gọi API
                timeout = setTimeout(function () {
                    $.ajax({
                        url: '@Url.Action("GetGiaoVienInfo", "TaiKhoan")',
                        type: 'GET',
                        data: { magv: magv },
                        success: function (res) {
                            if (res.success) {
                                $('#FullName').val(res.fullName);
                            } else {
                                $('#gvError').text(res.message).show();
                            }
                        },
                        error: function (xhr) {
                            $('#gvError').text('Lỗi kết nối hoặc lỗi server.').show();
                        }
                    });
                }, 500);
            });
        });
    </script>
}
