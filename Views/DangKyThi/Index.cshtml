@model List<DMS_Examify.Models.GiaoVienDangKy>
@{
    ViewData["Title"] = "Đăng ký thi";
    ViewData["Subtitle"] = "Lên lịch thi cho lớp";
}

<div class="row g-4">
    <!-- Form đăng ký -->
    <div class="col-md-5 animate-in animate-in-delay-1">
        <div class="card">
            <div class="card-header">
                <span><i class="bi bi-calendar-plus me-2"></i>Đăng ký lịch thi</span>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label">Lớp</label>
                    <select class="form-select" id="selLop">
                        @if (ViewBag.Lops != null)
                        {
                            foreach (var lop in ViewBag.Lops)
                            {
                                <option value="@lop.Value">@lop.Text</option>
                            }
                        }
                    </select>
                </div>
                @if (ViewBag.IsPGV == true)
                {
                <div class="mb-3">
                    <label class="form-label">Giáo viên</label>
                    <select class="form-select" id="selGiaoVien">
                        @if (ViewBag.GiaoViens != null)
                        {
                            foreach (var gv in ViewBag.GiaoViens)
                            {
                                <option value="@gv.Value">@gv.Text</option>
                            }
                        }
                    </select>
                </div>
                }
                <div class="mb-3">
                    <label class="form-label">Môn học</label>
                    <select class="form-select" id="selMonHoc">
                        @if (ViewBag.MonHocs != null)
                        {
                            foreach (var mon in ViewBag.MonHocs)
                            {
                                <option value="@mon.Value">@mon.Text</option>
                            }
                        }
                    </select>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Trình độ</label>
                        <select class="form-select" id="selTrinhDoDK">
                            @if (ViewBag.TrinhDos != null)
                            {
                                foreach (var trinhDo in ViewBag.TrinhDos)
                                {
                                    <option value="@trinhDo.Value">@trinhDo.Text</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Lần thi</label>
                        <select class="form-select" id="selLanThi">
                            <option value="1">Lần 1</option>
                            <option value="2">Lần 2</option>
                        </select>
                    </div>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label class="form-label">Số câu thi</label>
                        <input type="number" class="form-control" id="txtSoCau" placeholder="20" value="20" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Ngày thi</label>
                        <input type="date" class="form-control" id="txtNgayThiDK" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Thời gian (phút)</label>
                        <input type="number" class="form-control" id="txtThoiGian" placeholder="45" value="45" />
                    </div>
                </div>

                <!-- Cảnh báo số câu hỏi -->
                <div class="alert alert-info" id="alertSoCau">
                    <i class="bi bi-info-circle me-1"></i>
                    Số câu hỏi của trình độ bạn chọn hiện có trong bộ đề: <strong id="lblSoCau">...</strong> câu.
                    Vui lòng kiểm tra đủ số câu trước khi đăng ký.
                </div>

                <div class="d-flex gap-2 flex-wrap">
                    <button type="button" class="btn btn-primary btn-sm px-3" id="btnDangKy">
                        <i class="bi bi-plus-lg me-1"></i> Thêm
                    </button>
                    <button type="button" class="btn btn-warning btn-sm px-3 text-white" id="btnSuaDK" disabled>
                        <i class="bi bi-pencil-square me-1"></i> Sửa
                    </button>
                    <button type="button" class="btn btn-danger btn-sm px-3" id="btnXoaDK" disabled>
                        <i class="bi bi-trash me-1"></i> Xóa
                    </button>
                    <button type="button" class="btn btn-secondary btn-sm px-3" id="btnHuy">
                        <i class="bi bi-arrow-clockwise me-1"></i> Reset
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Danh sách đã đăng ký -->
    <div class="col-md-7 animate-in animate-in-delay-2">
        <div class="card">
            <div class="card-header">
                <span><i class="bi bi-calendar-check me-2"></i>Danh sách đăng ký thi</span>
                <span class="badge bg-primary">@Model.Count lịch</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0" id="tblDangKy">
                        <thead>
                            <tr>
                                @if (ViewBag.IsPGV == true)
                                {
                                    <th>Giáo viên</th>
                                }
                                <th>Lớp</th>
                                <th>Môn học</th>
                                <th>Trình độ</th>
                                <th>Lần</th>
                                <th>Số câu</th>
                                <th>Ngày thi</th>
                                <th>TG (phút)</th>
                                <th>Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var dk in Model)
                            {
                                var badgeClass = dk.TrinhDo == "A" ? "badge-level-a" : dk.TrinhDo == "B" ? "badge-level-b" : "badge-level-c";
                                var rowClass = dk.DaThi ? "table-secondary text-muted" : "";
                                <tr class="@rowClass"
                                    style="cursor: @(dk.DaThi ? "default" : "pointer")"
                                    data-magv="@dk.MaGV"
                                    data-mamh="@dk.MaMH"
                                    data-malop="@dk.MaLop"
                                    data-trinhdo="@dk.TrinhDo"
                                    data-lan="@dk.Lan"
                                    data-socau="@dk.SoCauThi"
                                    data-ngaythi="@dk.NgayThi.ToString("yyyy-MM-dd")"
                                    data-thoigian="@dk.ThoiGian"
                                    data-dathi="@dk.DaThi.ToString().ToLower()">
                                    @if (ViewBag.IsPGV == true)
                                    {
                                        <td>@dk.MaGV.Trim() - @dk.TenGV</td>
                                    }
                                    <td><strong>@dk.MaLop.Trim()</strong> <small class="text-muted">@dk.TenLop</small></td>
                                    <td>@dk.TenMH</td>
                                    <td><span class="badge @badgeClass">@dk.TrinhDo</span></td>
                                    <td>@dk.Lan</td>
                                    <td>@dk.SoCauThi</td>
                                    <td>@dk.NgayThi.ToString("dd/MM/yyyy")</td>
                                    <td>@dk.ThoiGian</td>
                                    <td>
                                        @if (dk.DaThi)
                                        {
                                            <span class="badge bg-secondary">Đã thi</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">Chưa thi</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Confirm Modal -->
<div class="modal fade" id="confirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-3">
            <div class="modal-header border-0 bg-light py-3">
                <h5 class="modal-title fw-semibold" id="confirmModalTitle">Xác nhận</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body py-4 fs-6" id="confirmModalMessage"></div>
            <div class="modal-footer border-0 bg-light py-2">
                <button type="button" class="btn btn-secondary btn-sm px-3" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-danger btn-sm px-3" id="btnConfirmOk">Xác nhận</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            var selectedRow = null;

            function loadSoCauHoi() {
                var maMH = $("#selMonHoc").val();
                var trinhDo = $("#selTrinhDoDK").val();

                if (maMH && trinhDo) {
                    $.ajax({
                        url: '@Url.Action("GetSoCauHoi", "DangKyThi")',
                        type: 'GET',
                        data: { maMH: maMH, trinhDo: trinhDo },
                        success: function(res) {
                            $("#lblSoCau").text(res.success ? res.soCau : "0");
                        },
                        error: function() {
                            $("#lblSoCau").text("0");
                        }
                    });
                }
            }

            $("#selMonHoc, #selTrinhDoDK").change(function() {
                loadSoCauHoi();
            });

            loadSoCauHoi();

            var today = new Date().toISOString().split('T')[0];
            $("#txtNgayThiDK").attr('min', today);

            function getFormModel() {
                return {
                    MaGV: $("#selGiaoVien").length ? $("#selGiaoVien").val() : null,
                    MaLop: $("#selLop").val(),
                    MaMH: $("#selMonHoc").val(),
                    TrinhDo: $("#selTrinhDoDK").val(),
                    Lan: parseInt($("#selLanThi").val()),
                    SoCauThi: parseInt($("#txtSoCau").val()),
                    NgayThi: $("#txtNgayThiDK").val(),
                    ThoiGian: parseInt($("#txtThoiGian").val())
                };
            }

            function validateForm(model) {
                if (!model.NgayThi) { alert("Vui lòng chọn ngày thi."); return false; }
                if (model.NgayThi < today) { alert("Ngày thi không được ở trong quá khứ."); return false; }
                if (isNaN(model.SoCauThi) || model.SoCauThi <= 0) { alert("Số câu thi không hợp lệ."); return false; }
                if (isNaN(model.ThoiGian) || model.ThoiGian <= 0) { alert("Thời gian thi không hợp lệ."); return false; }
                return true;
            }

            function resetForm() {
                selectedRow = null;
                $("#selLop").prop("selectedIndex", 0);
                if ($("#selGiaoVien").length) $("#selGiaoVien").prop("selectedIndex", 0);
                $("#selMonHoc").prop("selectedIndex", 0);
                $("#selTrinhDoDK").prop("selectedIndex", 0);
                $("#selLanThi").val("1");
                $("#txtSoCau").val("20");
                $("#txtNgayThiDK").val("");
                $("#txtThoiGian").val("45");
                $("#tblDangKy tbody tr").removeClass("table-primary");
                $("#btnSuaDK, #btnXoaDK").prop("disabled", true);
                loadSoCauHoi();
            }

            // --- THÊM ---
            $("#btnDangKy").click(function() {
                var model = getFormModel();
                if (!validateForm(model)) return;

                $.ajax({
                    url: '@Url.Action("DangKy", "DangKyThi")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(model),
                    success: function(res) {
                        if (res.success) {
                            alert(res.message);
                            location.reload();
                        } else {
                            alert("Lỗi: " + res.message);
                        }
                    },
                    error: function() { alert("Có lỗi xảy ra trong quá trình kết nối."); }
                });
            });

            // --- SỬA ---
            $("#btnSuaDK").click(function() {
                if (!selectedRow) return;
                var model = getFormModel();
                if (!validateForm(model)) return;

                $.ajax({
                    url: '@Url.Action("CapNhat", "DangKyThi")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(model),
                    success: function(res) {
                        if (res.success) {
                            alert(res.message);
                            location.reload();
                        } else {
                            alert("Lỗi: " + res.message);
                        }
                    },
                    error: function() { alert("Có lỗi xảy ra trong quá trình kết nối."); }
                });
            });

            // --- XÓA ---
            $("#btnXoaDK").click(function() {
                if (!selectedRow) return;
                $("#confirmModalTitle").text("Xác nhận xóa");
                $("#confirmModalMessage").text("Bạn có chắc muốn xóa đăng ký thi này không?");
                var modal = new bootstrap.Modal(document.getElementById('confirmModal'));
                modal.show();

                $("#btnConfirmOk").off("click").on("click", function() {
                    modal.hide();
                    var data = {
                        MaMH: selectedRow.data("mamh").toString().trim(),
                        MaLop: selectedRow.data("malop").toString().trim(),
                        Lan: parseInt(selectedRow.data("lan"))
                    };

                    $.ajax({
                        url: '@Url.Action("Xoa", "DangKyThi")',
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(data),
                        success: function(res) {
                            if (res.success) {
                                alert(res.message);
                                location.reload();
                            } else {
                                alert("Lỗi: " + res.message);
                            }
                        },
                        error: function() { alert("Có lỗi xảy ra trong quá trình kết nối."); }
                    });
                });
            });

            // --- RESET ---
            $("#btnHuy").click(function() {
                resetForm();
            });

            // --- CLICK ROW ---
            $("#tblDangKy tbody").on("click", "tr", function() {
                var daThi = $(this).data("dathi");
                if (daThi === true || daThi === "true") return;

                selectedRow = $(this);
                $("#tblDangKy tbody tr").removeClass("table-primary");
                $(this).addClass("table-primary");

                if ($("#selGiaoVien").length) {
                    $("#selGiaoVien").val(selectedRow.data("magv").toString().trim());
                }
                $("#selLop").val(selectedRow.data("malop").toString().trim());
                $("#selMonHoc").val(selectedRow.data("mamh").toString().trim());
                $("#selTrinhDoDK").val(selectedRow.data("trinhdo").toString().trim());
                $("#selLanThi").val(selectedRow.data("lan"));
                $("#txtSoCau").val(selectedRow.data("socau"));
                $("#txtNgayThiDK").val(selectedRow.data("ngaythi"));
                $("#txtThoiGian").val(selectedRow.data("thoigian"));

                $("#btnSuaDK, #btnXoaDK").prop("disabled", false);
                loadSoCauHoi();
            });
        });
    </script>
}
