@model DMS_Examify.Models.ThiChonViewModel
@{
    ViewData["Title"] = "Thi trắc nghiệm";
    ViewData["Subtitle"] = "Chọn thông tin và bắt đầu thi";
}

<div class="row justify-content-center">
    <div class="col-md-7 animate-in">
        <div class="card">
            <div class="card-header">
                <span><i class="bi bi-pencil-square me-2"></i>Thông tin thi</span>
            </div>
            <div class="card-body">
                <!-- Thông tin SV (tự động) -->
                <div class="alert alert-info mb-4">
                    <div class="row">
                        <div class="col-md-6">
                            <strong>Mã lớp:</strong> @Model.MaLop
                        </div>
                        <div class="col-md-6">
                            <strong>Tên lớp:</strong> @Model.TenLop
                        </div>
                        <div class="col-md-6 mt-1">
                            <strong>Mã SV:</strong> @Model.MaSV
                        </div>
                        <div class="col-md-6 mt-1">
                            <strong>Họ tên:</strong> @Model.HoTen
                        </div>
                    </div>
                </div>

                <!-- Chọn môn thi -->
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Môn học</label>
                        <select class="form-select" id="selMonThi">
                            @foreach (var mh in Model.DanhSachMH)
                            {
                                <option value="@mh.MaMH">@mh.TenMH</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Ngày thi</label>
                        <input type="date" class="form-control" id="txtNgayThi" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Lần thi</label>
                        <select class="form-select" id="selLanThiSV">
                            <option value="1">Lần 1</option>
                            <option value="2">Lần 2</option>
                        </select>
                    </div>
                </div>

                <!-- Thông tin tự động lọc -->
                <div class="card mb-4" style="background:#f8fafc; border:1px dashed var(--border-color);">
                    <div class="card-body">
                        <div class="row text-center">
                            <div class="col-md-4">
                                <div style="font-size:28px; font-weight:700; color:var(--primary);">20</div>
                                <div style="font-size:12px; color:var(--text-secondary);">Số câu thi</div>
                            </div>
                            <div class="col-md-4">
                                <div style="font-size:28px; font-weight:700; color:var(--warning);">45</div>
                                <div style="font-size:12px; color:var(--text-secondary);">Phút</div>
                            </div>
                            <div class="col-md-4">
                                <div><span class="badge badge-level-b" style="font-size:20px; padding:8px 20px;">B</span></div>
                                <div style="font-size:12px; color:var(--text-secondary); margin-top:4px;">Trình độ</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Nút bắt đầu -->
                <div class="text-center">
                    <a asp-action="LamBai" class="btn btn-primary" style="padding:14px 48px; font-size:16px; font-weight:600; border-radius:12px;">
                        <i class="bi bi-play-fill me-2"></i>Bắt đầu thi
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
