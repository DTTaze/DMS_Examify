@model DMS_Examify.Models.ThiLamBaiViewModel
@{
    ViewData["Title"] = Model.IsThiThu ? "Thi thử" : "Làm bài thi";
}

<div class="exam-container" data-mamh="@Model.MaMH" data-lan="@Model.Lan" data-is-thithu="@Model.IsThiThu.ToString().ToLower()">
    <!-- Header thi -->
    <div class="row g-3 mb-4 align-items-center animate-in">
        <div class="col-md-4">
            <div style="font-size:12px; color:var(--text-secondary);">MÔN THI</div>
            <div style="font-size:18px; font-weight:700;">@Model.TenMH</div>
            <div style="font-size:12px; color:var(--text-muted);">
                @Model.HoTen • Lần @Model.Lan •
                <span class="badge badge-level-@Model.TrinhDo.ToLower()">Trình độ @Model.TrinhDo</span>
                @if (Model.IsThiThu)
                {
                    <span class="badge bg-warning text-dark ms-1">Thi thử</span>
                }
            </div>
        </div>
        <div class="col-md-4 text-center">
            <div class="exam-timer" id="examTimer">
                --:--
            </div>
        </div>
        <div class="col-md-4 text-end">
            <button class="btn btn-danger" style="padding:10px 28px; font-weight:600;" onclick="nopBai()">
                <i class="bi bi-send me-1"></i> @(Model.IsThiThu ? "Kết thúc thi thử" : "Nộp bài")
            </button>
        </div>
    </div>

    @if (Model.IsThiThu)
    {
        <div class="alert alert-warning border-0 mb-3" style="background: rgba(255,193,7,0.12); font-size: 13px;">
            <i class="bi bi-mortarboard me-1"></i>
            <strong>Chế độ thi thử</strong> — Kết quả chấm điểm nhưng không ghi vào bảng điểm.
        </div>
    }

    <!-- Progress dots -->
    <div class="exam-progress mb-4 animate-in animate-in-delay-1">
        @for (int i = 0; i < Model.DanhSachCauHoi.Count; i++)
        {
            var ch = Model.DanhSachCauHoi[i];
            var isFirst = (i == 0);
            var isAnswered = !string.IsNullOrWhiteSpace(ch.TraLoiSV);
            <div class="q-dot @(isFirst ? "current" : "") @(isAnswered ? "answered" : "")"
                 onclick="goToQuestion(@ch.STT)" id="dot-@ch.STT">
                @ch.STT
            </div>
        }
    </div>

    <!-- Câu hỏi -->
    @for (int i = 0; i < Model.DanhSachCauHoi.Count; i++)
    {
        var ch = Model.DanhSachCauHoi[i];
        var isFirst = (i == 0);
        <div class="question-card animate-in animate-in-delay-2" id="q-@ch.STT"
             style="@(isFirst ? "" : "display:none;")" data-cauhoi="@ch.CauHoi">
            <div class="q-number">Câu @ch.STT / @Model.DanhSachCauHoi.Count — Câu số @ch.CauHoi trong bộ đề</div>
            <div class="q-text">@ch.NoiDung</div>

            @foreach (var letter in new[] { "A", "B", "C", "D" })
            {
                var optionText = letter switch { "A" => ch.DapAnA, "B" => ch.DapAnB, "C" => ch.DapAnC, _ => ch.DapAnD };
                var isSelected = string.Equals(ch.TraLoiSV?.Trim(), letter, StringComparison.OrdinalIgnoreCase);
                <div class="q-option @(isSelected ? "selected" : "")"
                     onclick="chonDapAn(@ch.STT, '@letter', this)" data-answer="@letter">
                    <div class="option-letter">@letter</div>
                    <div>@optionText</div>
                </div>
            }

            <!-- Navigation -->
            <div class="d-flex justify-content-between mt-4">
                @if (ch.STT > 1)
                {
                    <button class="btn btn-outline-secondary" onclick="goToQuestion(@(ch.STT - 1))">
                        <i class="bi bi-chevron-left"></i> Câu trước
                    </button>
                }
                else
                {
                    <div></div>
                }

                @if (ch.STT < Model.DanhSachCauHoi.Count)
                {
                    <button class="btn btn-primary" onclick="goToQuestion(@(ch.STT + 1))">
                        Câu sau <i class="bi bi-chevron-right"></i>
                    </button>
                }
                else
                {
                    <button class="btn btn-danger" onclick="nopBai()">
                        <i class="bi bi-send"></i> @(Model.IsThiThu ? "Kết thúc thi thử" : "Nộp bài")
                    </button>
                }
            </div>
        </div>
    }
</div>

<!-- Modal kết quả -->
<div class="modal fade" id="resultModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius:20px; border:none;">
            <div class="modal-body">
                <div class="score-display">
                    <div style="font-size:48px; margin-bottom:16px;">
                        @(Model.IsThiThu ? "📝" : "🎉")
                    </div>
                    <div class="score-value" id="scoreValue">0</div>
                    <div class="score-label">điểm</div>
                    @if (Model.IsThiThu)
                    {
                        <div style="margin-top:8px; font-size:13px; color:var(--warning); font-weight:600;">
                            <i class="bi bi-mortarboard me-1"></i>Kết quả thi thử — Không ghi điểm
                        </div>
                    }
                    <div style="margin-top:12px; color:var(--text-secondary);">
                        Số câu đúng: <strong id="correctCount">0</strong> / <span id="totalCount">@Model.DanhSachCauHoi.Count</span>
                    </div>
                    <div style="margin-top:24px;">
                        @if (Model.IsThiThu)
                        {
                            <a asp-controller="Thi" asp-action="Index" class="btn btn-primary" style="padding:10px 32px;">
                                <i class="bi bi-arrow-repeat me-1"></i> Thi thử lại
                            </a>
                            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary ms-2" style="padding:10px 32px;">
                                Về trang chủ
                            </a>
                        }
                        else
                        {
                            <a asp-controller="KetQua" asp-action="Index" class="btn btn-primary" style="padding:10px 32px;">
                                <i class="bi bi-eye me-1"></i> Xem chi tiết
                            </a>
                            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary ms-2" style="padding:10px 32px;">
                                Về trang chủ
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const container = document.querySelector('.exam-container');
            const maMH = container.dataset.mamh;
            const lan = Number(container.dataset.lan);
            const isThiThu = container.dataset.isThithu === 'true';
            const totalQuestions = @Model.DanhSachCauHoi.Count;

            let currentQuestion = 1;
            let isSubmitting = false;

            // --- Timer (dùng ThoiGianConLaiGiay để hỗ trợ resume) ---
            let timeLeft = @Model.ThoiGianConLaiGiay;
            const timerEl = document.getElementById('examTimer');

            function updateTimerDisplay() {
                const mins = Math.floor(timeLeft / 60);
                const secs = timeLeft % 60;
                timerEl.textContent = `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;

                if (timeLeft <= 60) {
                    timerEl.classList.add('warning');
                }
            }

            updateTimerDisplay();

            const timerInterval = setInterval(() => {
                timeLeft--;
                updateTimerDisplay();

                if (timeLeft <= 0) {
                    clearInterval(timerInterval);
                    nopBai();
                }
            }, 1000);

            // --- Chọn đáp án: cập nhật UI + gọi API lưu vào DB ---
            window.chonDapAn = function (stt, answer, el) {
                const parent = el.parentElement;
                parent.querySelectorAll('.q-option').forEach(o => o.classList.remove('selected'));
                el.classList.add('selected');

                document.getElementById('dot-' + stt).classList.add('answered');

                const cauHoi = document.getElementById('q-' + stt).dataset.cauhoi;

                fetch('/Thi/TraLoiCauHoi', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        maMH: maMH,
                        lan: lan,
                        cauHoi: Number(cauHoi),
                        cauTraLoi: answer
                    })
                }).catch(() => { /* silent - tiep tuc lam bai */ });
            };

            // --- Chuyển câu hỏi ---
            window.goToQuestion = function (stt) {
                document.querySelectorAll('.question-card').forEach(q => q.style.display = 'none');
                document.getElementById('q-' + stt).style.display = 'block';

                document.querySelectorAll('.q-dot').forEach(d => d.classList.remove('current'));
                document.getElementById('dot-' + stt).classList.add('current');

                currentQuestion = stt;
            };

            // --- Nộp bài: gọi API server chấm điểm ---
            window.nopBai = function () {
                if (isSubmitting) return;
                isSubmitting = true;
                clearInterval(timerInterval);

                fetch('/Thi/NopBaiThi', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ maMH: maMH, lan: lan })
                })
                    .then(r => r.json())
                    .then(data => {
                        if (data.success) {
                            document.getElementById('scoreValue').textContent =
                                parseFloat(data.diem).toFixed(1);
                            document.getElementById('correctCount').textContent = data.soCauDung;
                            document.getElementById('totalCount').textContent = data.tongSoCau;
                        } else {
                            document.getElementById('scoreValue').textContent = '--';
                            document.getElementById('correctCount').textContent = data.message || 'Lỗi nộp bài';
                        }

                        const modal = new bootstrap.Modal(document.getElementById('resultModal'));
                        modal.show();
                    })
                    .catch(() => {
                        document.getElementById('scoreValue').textContent = '--';
                        document.getElementById('correctCount').textContent = 'Không thể kết nối server';

                        const modal = new bootstrap.Modal(document.getElementById('resultModal'));
                        modal.show();
                    });
            };
        })();
    </script>
}
