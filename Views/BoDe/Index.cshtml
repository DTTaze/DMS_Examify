@model BoDeViewModel
@{
  ViewData["Title"] = "Nhập câu hỏi thi";
  ViewData["Subtitle"] = "Quản lý bộ đề trắc nghiệm";
}

<div class="row g-4">
  <div class="col-md-6">
    <div class="card">
      <div class="card-header">
        <span>Nhập câu hỏi</span>
      </div>
      <div class="card-body">

        <div class="mb-3">
          <label>Câu hỏi số</label>
          <input type="number" class="form-control" id="txtCauHoi" disabled />
        </div>

        <div class="row mb-3">
          <div class="col-md-6">
            <label>Môn học</label>
            <select class="form-select" id="selMaMH">
              @foreach (var mh in Model.MonHocList)
              {
                <option value="@mh.MaMH">@mh.TenMH</option>
              }
            </select>
          </div>

          <div class="col-md-6">
            <label>Trình độ</label>
            <select class="form-select" id="selTrinhDo">
              <option value="A">A</option>
              <option value="B">B</option>
              <option value="C">C</option>
            </select>
          </div>
        </div>

        <div class="mb-3">
          <label>Nội dung</label>
          <textarea id="txtNoiDung" class="form-control"></textarea>
        </div>

        <div class="row mb-3">
          <div class="col-md-6"><input id="txtA" class="form-control" placeholder="Đáp án A"></div>
          <div class="col-md-6"><input id="txtB" class="form-control" placeholder="Đáp án B"></div>
          <div class="col-md-6"><input id="txtC" class="form-control" placeholder="Đáp án C"></div>
          <div class="col-md-6"><input id="txtD" class="form-control" placeholder="Đáp án D"></div>
        </div>

        <div class="mb-3">
          <label>Đáp án đúng</label>
          <select id="selDapAn" class="form-select" style="width:120px">
            <option>A</option>
            <option>B</option>
            <option>C</option>
            <option>D</option>
          </select>
        </div>

        <div class="d-flex gap-2 flex-wrap">
          <button class="btn btn-primary" onclick="addQuestion()">Thêm</button>
          <button class="btn btn-warning" onclick="editQuestion()">Sửa</button>
          <button class="btn btn-danger" onclick="deleteQuestion()">Xóa</button>
          <button class="btn btn-secondary" onclick="undo()">Undo</button>
          <button class="btn btn-info" onclick="searchQuestion()">Tìm</button>
          <button class="btn btn-success" onclick="saveAll()">Lưu</button>
        </div>

      </div>
    </div>
  </div>

  <div class="col-md-6">
    <input id="txtSearch" class="form-control mb-2" placeholder="Tìm kiếm...">

    <div class="card">
      <div class="card-header">
        Danh sách câu hỏi (@Model.BoDes.Count)
      </div>

      <div class="card-body p-0">
        <table class="table table-hover">
          <thead>
            <tr>
              <th>Câu</th>
              <th>Nội dung</th>
              <th>Môn</th>
              <th>Level</th>
              <th>ĐA</th>
            </tr>
          </thead>
          <tbody>
            @foreach (var ch in Model.BoDes)
            {
              <tr data-id="@ch.CauHoi" data-mamh="@ch.MaMH" data-trinhdo="@ch.TrinhDo" data-noidung="@ch.NoiDung"
                  data-a="@ch.DapAnA" data-b="@ch.DapAnB" data-c="@ch.DapAnC" data-d="@ch.DapAnD" data-dapan="@ch.DapAn">
                <td>@ch.CauHoi</td>
                <td>@ch.NoiDung</td>
                <td>@ch.MaMH</td>
                <td>@ch.TrinhDo</td>
                <td>@ch.DapAn</td>
              </tr>
            }
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

@section Scripts {
  <script>
    let newItems = [];
    let updatedItems = [];
    let deletedItems = [];
    let selectedRow = null;
    let historyStack = [];
    let tempId = -1;

    function pushState() {
      historyStack.push({
        html: document.querySelector("tbody").innerHTML,
        newItems: JSON.parse(JSON.stringify(newItems)),
        updatedItems: JSON.parse(JSON.stringify(updatedItems)),
        deletedItems: JSON.parse(JSON.stringify(deletedItems))
      });
    }

    function undo() {
      if (!historyStack.length) return alert("Không có gì để undo");

      const s = historyStack.pop();
      document.querySelector("tbody").innerHTML = s.html;
      newItems = s.newItems;
      updatedItems = s.updatedItems;
      deletedItems = s.deletedItems;

      bindRows();
      selectedRow = null;
    }

    function getForm() {
      return {
        MaMH: selMaMH.value,
        TrinhDo: selTrinhDo.value,
        NoiDung: txtNoiDung.value.trim(),
        DapAnA: txtA.value.trim(),
        DapAnB: txtB.value.trim(),
        DapAnC: txtC.value.trim(),
        DapAnD: txtD.value.trim(),
        DapAn: selDapAn.value
      };
    }

    function fillForm(row) {
      txtCauHoi.value = row.dataset.id;
      selMaMH.value = row.dataset.mamh;
      selTrinhDo.value = row.dataset.trinhdo;
      txtNoiDung.value = row.dataset.noidung;
      txtA.value = row.dataset.a;
      txtB.value = row.dataset.b;
      txtC.value = row.dataset.c;
      txtD.value = row.dataset.d;
      selDapAn.value = row.dataset.dapan;
    }

    function bindRows() {
      document.querySelectorAll("tbody tr").forEach(r => {
        r.onclick = () => {
          document.querySelectorAll("tr").forEach(x => x.classList.remove("table-active"));
          r.classList.add("table-active");
          selectedRow = r;
          fillForm(r);
        };
      });
    }

    function addQuestion() {
      const d = getForm();
      if (!d.NoiDung) return alert("Nhập nội dung");

      pushState();

      const id = tempId--;
      newItems.push({ CauHoi: id, ...d });

      const row = document.querySelector("tbody").insertRow();
      row.dataset.id = id;
      Object.assign(row.dataset, {
        mamh: d.MaMH, trinhdo: d.TrinhDo, noidung: d.NoiDung,
        a: d.DapAnA, b: d.DapAnB, c: d.DapAnC, d: d.DapAnD, dapan: d.DapAn
      });

      row.innerHTML = `<td>...</td><td>${d.NoiDung}</td><td>${d.MaMH}</td><td>${d.TrinhDo}</td><td>${d.DapAn}</td>`;

      bindRows();
    }

    function editQuestion() {
      if (!selectedRow) return alert("Chọn dòng");

      const d = getForm();
      const id = parseInt(selectedRow.dataset.id);

      pushState();

      selectedRow.innerHTML = `<td>${id > 0 ? id : "..."}</td><td>${d.NoiDung}</td><td>${d.MaMH}</td><td>${d.TrinhDo}</td><td>${d.DapAn}</td>`;
      Object.assign(selectedRow.dataset, {
        mamh: d.MaMH, trinhdo: d.TrinhDo, noidung: d.NoiDung,
        a: d.DapAnA, b: d.DapAnB, c: d.DapAnC, d: d.DapAnD, dapan: d.DapAn
      });

      if (id < 0) {
        const i = newItems.findIndex(x => x.CauHoi === id);
        if (i >= 0) newItems[i] = { CauHoi: id, ...d };
      } else {
        updatedItems = updatedItems.filter(x => x.CauHoi !== id);
        updatedItems.push({ CauHoi: id, ...d });
      }
    }

    function deleteQuestion() {
      if (!selectedRow) return alert("Chọn dòng");

      const id = parseInt(selectedRow.dataset.id);
      const maMH = selectedRow.dataset.mamh;

      pushState();

      if (id < 0) {
        newItems = newItems.filter(x => x.CauHoi !== id);
      } else {
        updatedItems = updatedItems.filter(x => x.CauHoi !== id);
        if (!deletedItems.some(x => x.CauHoi === id))
          deletedItems.push({ CauHoi: id, MaMH: maMH });
      }

      selectedRow.remove();
      selectedRow = null;
    }

    async function saveAll() {
      for (const d of deletedItems)
        await fetch(`/BoDe/Delete?cauHoi=${d.CauHoi}&maMH=${d.MaMH}`, { method: "POST" });

      for (const u of updatedItems)
        await fetch(`/BoDe/Update`, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(u) });

      for (const n of newItems)
        await fetch(`/BoDe/Insert`, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(n) });

      alert("Xong");
      location.reload();
    }

    function searchQuestion() {
      const k = prompt("Nhập từ khóa");
      if (!k) return;

      fetch(`/BoDe/Search?keyword=${k}`)
        .then(r => r.json())
        .then(data => {
          const tbody = document.querySelector("tbody");
          tbody.innerHTML = "";
          data.forEach(x => {
            const row = tbody.insertRow();
            row.dataset.id = x.cauHoi;
            Object.assign(row.dataset, x);
            row.innerHTML = `<td>${x.cauHoi}</td><td>${x.noiDung}</td><td>${x.maMH}</td><td>${x.trinhDo}</td><td>${x.dapAn}</td>`;
          });
          bindRows();
        });
    }

    txtSearch.oninput = function () {
      const k = this.value.toLowerCase();
      document.querySelectorAll("tbody tr").forEach(r => {
        r.style.display = r.innerText.toLowerCase().includes(k) ? "" : "none";
      });
    };

    window.onload = bindRows;
  </script>
}