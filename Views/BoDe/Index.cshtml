@model List<DMS_Examify.Models.BoDe>
@{
    ViewData["Title"] = "Nhập câu hỏi thi";
    ViewData["Subtitle"] = "Quản lý bộ đề trắc nghiệm";
}

<div class="row g-4">
    <!-- Form nhập câu hỏi -->
    <div class="col-md-6 animate-in animate-in-delay-1">
        <div class="card">
            <div class="card-header">
                <span><i class="bi bi-file-earmark-plus me-2"></i>Nhập câu hỏi</span>
            </div>
            <div class="card-body">
                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label class="form-label">Câu hỏi số</label>
                        <input type="number" class="form-control" id="txtCauHoi" placeholder="1" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Môn học</label>
                        <select class="form-select" id="selMaMH">
                            <option value="MH001">Cơ sở dữ liệu</option>
                            <option value="MH002">Lập trình C++</option>
                            <option value="MH003">Mạng máy tính</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Trình độ</label>
                        <select class="form-select" id="selTrinhDo">
                            <option value="A">A - Dễ</option>
                            <option value="B">B - Trung bình</option>
                            <option value="C">C - Khó</option>
                        </select>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Nội dung câu hỏi</label>
                    <textarea class="form-control" id="txtNoiDung" rows="3" placeholder="Nhập nội dung câu hỏi..."></textarea>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Đáp án A</label>
                        <input type="text" class="form-control" id="txtA" placeholder="Đáp án A" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Đáp án B</label>
                        <input type="text" class="form-control" id="txtB" placeholder="Đáp án B" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Đáp án C</label>
                        <input type="text" class="form-control" id="txtC" placeholder="Đáp án C" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Đáp án D</label>
                        <input type="text" class="form-control" id="txtD" placeholder="Đáp án D" />
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Đáp án đúng</label>
                    <select class="form-select" id="selDapAn" style="width:120px;">
                        <option value="A">A</option>
                        <option value="B">B</option>
                        <option value="C">C</option>
                        <option value="D">D</option>
                    </select>
                </div>

                <div class="action-toolbar">
                    <button type="button" class="btn btn-primary" onclick="themBoDe()"><i class="bi bi-plus-lg"></i> Thêm</button>
                    <button type="button" class="btn btn-danger" onclick="xoaBoDe()"><i class="bi bi-trash"></i> Xóa</button>
                    <button type="button" class="btn btn-warning" onclick="hieuChinhBoDe()"><i class="bi bi-pencil-square"></i> Hiệu chỉnh</button>
                    <button type="button" class="btn btn-outline-secondary" onclick="phucHoiBoDe()"><i class="bi bi-arrow-counterclockwise"></i> Phục hồi</button>
                    <button type="button" class="btn btn-info" onclick="timBoDe()"><i class="bi bi-search"></i> Tìm</button>
                    <button type="button" class="btn btn-success" onclick="ghiBoDe()"><i class="bi bi-floppy"></i> Ghi</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Bảng danh sách câu hỏi -->
    <div class="col-md-6 animate-in animate-in-delay-2">
        <div class="card">
            <div class="card-header">
                <span><i class="bi bi-list-ol me-2"></i>Danh sách câu hỏi</span>
                <span class="badge bg-primary">@Model.Count câu</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th style="width:40px">Câu</th>
                                <th>Nội dung</th>
                                <th style="width:70px">Môn</th>
                                <th style="width:60px">Trình độ</th>
                                <th style="width:50px">ĐA</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ch in Model)
                            {
                                var badgeClass = ch.TrinhDo == "A" ? "badge-level-a" : ch.TrinhDo == "B" ? "badge-level-b" : "badge-level-c";
                                <tr style="cursor:pointer;" data-cauhoi="@ch.CauHoi" data-maMH="@ch.MaMH" data-trinhDo="@ch.TrinhDo" data-noiDung="@ch.NoiDung" data-dapAnA="@ch.DapAnA" data-dapAnB="@ch.DapAnB" data-dapAnC="@ch.DapAnC" data-dapAnD="@ch.DapAnD" data-dapAn="@ch.DapAn" data-maGV="@ch.MaGV" onclick="chonBoDe(this)">
                                    <td><strong>@ch.CauHoi</strong></td>
                                    <td style="max-width:200px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@ch.NoiDung</td>
                                    <td>@ch.MaMH</td>
                                    <td><span class="badge @badgeClass">@ch.TrinhDo</span></td>
                                    <td><span class="badge bg-dark">@ch.DapAn</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let selectedBoDeRow = null;

        function chonBoDe(row) {
            document.querySelectorAll('table tbody tr').forEach(r => r.classList.remove('selected'));
            row.classList.add('selected');
            selectedBoDeRow = row;

            document.getElementById('txtCauHoi').value = row.dataset.cauhoi;
            document.getElementById('selMaMH').value = row.dataset.maMH;
            document.getElementById('selTrinhDo').value = row.dataset.trinhDo;
            document.getElementById('txtNoiDung').value = row.dataset.noiDung;
            document.getElementById('txtA').value = row.dataset.dapAnA;
            document.getElementById('txtB').value = row.dataset.dapAnB;
            document.getElementById('txtC').value = row.dataset.dapAnC;
            document.getElementById('txtD').value = row.dataset.dapAnD;
            document.getElementById('selDapAn').value = row.dataset.dapAn;
            document.getElementById('txtMaGV').value = row.dataset.maGV || '';
        }

        function themBoDe() {
            selectedBoDeRow = null;
            document.getElementById('txtCauHoi').value = '';
            document.getElementById('selMaMH').selectedIndex = 0;
            document.getElementById('selTrinhDo').selectedIndex = 0;
            document.getElementById('txtNoiDung').value = '';
            document.getElementById('txtA').value = '';
            document.getElementById('txtB').value = '';
            document.getElementById('txtC').value = '';
            document.getElementById('txtD').value = '';
            document.getElementById('selDapAn').selectedIndex = 0;
            document.getElementById('txtMaGV').value = '';
        }

        function hieuChinhBoDe() {
            if (!selectedBoDeRow) { alert('Chọn câu hỏi để hiệu chỉnh'); return; }
            selectedBoDeRow.cells[0].innerHTML = '<strong>' + document.getElementById('txtCauHoi').value + '</strong>';
            selectedBoDeRow.cells[1].textContent = document.getElementById('txtNoiDung').value;
            selectedBoDeRow.cells[2].textContent = document.getElementById('selMaMH').value;
            selectedBoDeRow.cells[3].innerHTML = '<span class="badge badge-level-' + document.getElementById('selTrinhDo').value.toLowerCase() + '">' + document.getElementById('selTrinhDo').value + '</span>';
            selectedBoDeRow.cells[4].innerHTML = '<span class="badge bg-dark">' + document.getElementById('selDapAn').value + '</span>';
        }

        function phucHoiBoDe() {
            selectedBoDeRow = null;
            document.querySelectorAll('table tbody tr').forEach(r => r.classList.remove('selected'));
            themBoDe();
        }

        async function timBoDe() {
            const keyword = prompt('Nhập từ khóa tìm kiếm:');
            if (keyword == null) return;
            const res = await fetch('/BoDe/Search?keyword=' + encodeURIComponent(keyword));
            if (!res.ok) { alert('Tìm kiếm thất bại'); return; }
            const list = await res.json();

            const tbody = document.querySelector('table tbody');
            tbody.innerHTML = '';
            list.forEach((item, idx) => {
                const row = tbody.insertRow();
                row.style.cursor = 'pointer';
                row.dataset.cauhoi = item.cauHoi;
                row.dataset.maMH = item.maMH;
                row.dataset.trinhDo = item.trinhDo;
                row.dataset.noiDung = item.noiDung;
                row.dataset.dapAnA = item.dapAnA;
                row.dataset.dapAnB = item.dapAnB;
                row.dataset.dapAnC = item.dapAnC;
                row.dataset.dapAnD = item.dapAnD;
                row.dataset.dapAn = item.dapAn;
                row.dataset.maGV = item.maGV;
                row.onclick = () => chonBoDe(row);

                const badgeClass = item.trinhDo === 'A' ? 'badge-level-a' : item.trinhDo === 'B' ? 'badge-level-b' : 'badge-level-c';

                row.innerHTML = `<td><strong>${item.cauHoi}</strong></td><td style="max-width:200px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">${item.noiDung}</td><td>${item.maMH}</td><td><span class="badge ${badgeClass}">${item.trinhDo}</span></td><td><span class="badge bg-dark">${item.dapAn}</span></td>`;
            });
        }

        async function ghiBoDe() {
            const boDe = {
                CauHoi: parseInt(document.getElementById('txtCauHoi').value, 10) || 0,
                MaMH: document.getElementById('selMaMH').value,
                TrinhDo: document.getElementById('selTrinhDo').value,
                NoiDung: document.getElementById('txtNoiDung').value.trim(),
                DapAnA: document.getElementById('txtA').value.trim(),
                DapAnB: document.getElementById('txtB').value.trim(),
                DapAnC: document.getElementById('txtC').value.trim(),
                DapAnD: document.getElementById('txtD').value.trim(),
                DapAn: document.getElementById('selDapAn').value,
                MaGV: document.getElementById('txtMaGV').value.trim()
            };
            if (!boDe.CauHoi || !boDe.MaMH || !boDe.NoiDung || !boDe.DapAn) { alert('Thông tin chưa đầy đủ'); return; }
            const url = selectedBoDeRow ? '/BoDe/Update' : '/BoDe/Insert';
            const res = await fetch(url, { method:'POST', headers:{ 'Content-Type':'application/json' }, body: JSON.stringify(boDe)});
            if (res.ok) { alert('Ghi thành công'); location.reload(); } else { alert('Lỗi:' + await res.text()); }
        }

        async function xoaBoDe() {
            if (!selectedBoDeRow) { alert('Chọn câu hỏi để xóa'); return; }
            if (!confirm('Xác nhận xóa?')) return;
            const cauHoi = parseInt(document.getElementById('txtCauHoi').value, 10);
            const maMH = document.getElementById('selMaMH').value;
            const res = await fetch('/BoDe/Delete?cauHoi=' + cauHoi + '&maMH=' + encodeURIComponent(maMH), { method:'POST' });
            if (res.ok) { alert('Xóa thành công'); location.reload(); } else { alert('Xóa thất bại'); }
        }
    </script>
}
