@model BoDeViewModel

@{
    ViewData["Title"] = "Nhập câu hỏi thi";
    ViewData["Subtitle"] = "Quản lý Bộ đề trắc nghiệm";
}

@section Styles {
    <link rel="stylesheet" href="~/css/bode.css" asp-append-version="true" />
}

<div class="row g-4">
    <!-- FORM -->
    <div class="col-12 mb-4">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-white border-bottom fw-bold py-3">Thông tin Câu hỏi thi</div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-2">
                        <label class="form-label fw-medium">Câu hỏi số</label>
                        <input type="number" class="form-control shadow-none" id="txtCauHoi" disabled placeholder="Tự sinh" />
                    </div>
                    <div class="col-md-5">
                        <label class="form-label fw-medium">Môn học <span class="text-danger">*</span></label>
                        <select class="form-select shadow-none" id="selMaMH">
                            @foreach (var mh in Model.MonHocList)
                            {
                                <option value="@mh.MaMH">@mh.TenMH</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-5">
                        <label class="form-label fw-medium">Trình độ <span class="text-danger">*</span></label>
                        <select class="form-select shadow-none" id="selTrinhDo">
                            <option value="A">A - Đại học, chuyên ngành</option>
                            <option value="B">B - Đại học, không chuyên ngành</option>
                            <option value="C">C - Cao đẳng</option>
                        </select>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-medium">Nội dung câu hỏi <span class="text-danger">*</span></label>
                    <textarea id="txtNoiDung" class="form-control shadow-none" rows="3" placeholder="Nhập câu hỏi..."></textarea>

                </div>

                <div class="row mb-3">
                    <div class="col-md-6 mb-3 mb-md-0">
                        <label class="form-label fw-medium">Phương án A <span class="text-danger">*</span></label>
                        <input id="txtA" class="form-control shadow-none" placeholder="Phương án A" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-medium">Phương án B <span class="text-danger">*</span></label>
                        <input id="txtB" class="form-control shadow-none" placeholder="Phương án B" />
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-6 mb-3 mb-md-0">
                        <label class="form-label fw-medium">Phương án C <span class="text-danger">*</span></label>
                        <input id="txtC" class="form-control shadow-none" placeholder="Phương án C" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-medium">Phương án D <span class="text-danger">*</span></label>
                        <input id="txtD" class="form-control shadow-none" placeholder="Phương án D" />
                    </div>
                    <div class="col-12 mt-2">
                        <div id="answerDuplicateFeedback" class="text-danger small fw-medium" style="display: none;"></div>
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-md-4">
                        <label class="form-label fw-medium">Đáp án đúng <span class="text-danger">*</span></label>
                        <select id="selDapAn" class="form-select shadow-none" style="width: 120px;">
                            <option value="A">A</option>
                            <option value="B">B</option>
                            <option value="C">C</option>
                            <option value="D">D</option>
                        </select>
                    </div>
                </div>

                <div class="d-flex gap-2 flex-wrap mt-2">
                    <span id="wrapThem" class="d-inline-block">
                        <button type="button" class="btn btn-primary px-4 animate-btn" id="btnThem" onclick="addQuestion()" disabled>
                            <i class="bi bi-plus-lg me-1"></i> Thêm
                        </button>
                    </span>
                    <span id="wrapSua" class="d-inline-block">
                        <button type="button" class="btn btn-warning px-4 text-white animate-btn" id="btnSua" onclick="editQuestion()" disabled>
                            <i class="bi bi-pencil-square me-1"></i> Sửa
                        </button>
                    </span>

                    <button type="button" class="btn btn-secondary px-4 animate-btn" onclick="resetQuestionForm()">
                        <i class="bi bi-arrow-repeat me-1"></i> Đặt lại
                    </button>
                    <div class="vr mx-2 d-none d-md-block"></div>
                    <span id="wrapUndo" class="d-inline-block" title="Chưa có thao tác nào để hoàn tác.">
                        <button type="button" class="btn btn-outline-info animate-btn" id="btnUndo" onclick="undoBD()" disabled title="Chưa có thao tác nào để hoàn tác.">
                            <i class="bi bi-arrow-counterclockwise"></i> Undo
                        </button>
                    </span>
                    <span id="wrapRedo" class="d-inline-block" title="Chưa có thao tác nào để làm lại.">
                        <button type="button" class="btn btn-outline-info animate-btn" id="btnRedo" onclick="redoBD()" disabled title="Chưa có thao tác nào để làm lại.">
                            <i class="bi bi-arrow-clockwise"></i> Redo
                        </button>
                    </span>
                    <span id="wrapGhi" class="d-inline-block ms-auto mt-2 mt-md-0">
                        <button type="button" class="btn btn-success animate-btn px-4" id="btnGhi" onclick="saveAll()" disabled>
                            <i class="bi bi-cloud-arrow-up me-1"></i> Ghi (Lưu CSDL)
                        </button>
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- TABLE -->
    <div class="col-12">
        <div class="card shadow-sm border-0 rounded-3 text-dark">
            <div class="card-header d-flex justify-content-between align-items-center py-2">
                <span>Danh sách Câu hỏi (<span id="lblCount">@Model.BoDes.Count</span>)</span>
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-outline-success btn-sm animate-btn text-nowrap" onclick="exportExcel()" title="Xuất Excel">
                        <i class="bi bi-file-earmark-excel"></i> Xuất Excel
                    </button>
                    <button type="button" class="btn btn-outline-primary btn-sm animate-btn text-nowrap" onclick="openImportModal()" title="Nhập dữ liệu từ file Excel">
                        <i class="bi bi-file-earmark-arrow-up"></i> Nhập Excel
                    </button>
                    <div class="input-group input-group-sm mb-0" style="width: 250px;">
                        <span class="input-group-text bg-white border-end-0 text-secondary"><i class="bi bi-search"></i></span>
                        <input id="txtSearch" class="form-control border-start-0 shadow-none ps-0" placeholder="Tìm kiếm câu hỏi..." />
                    </div>
                </div>
            </div>

            <div class="card-body p-0 table-responsive border rounded-3 mb-0" style="max-height: 520px; overflow-y: auto;">
                <table class="table table-hover align-middle mb-0" id="tbl">
                    <thead class="table-light sticky-top">
                        <tr>
                            <th style="width: 70px;">Câu</th>
                            <th>Nội dung câu hỏi</th>
                            <th style="width: 90px;">Môn học</th>
                            <th style="width: 80px;">Trình độ</th>
                            <th style="width: 80px;">Đáp án</th>
                            <th class="text-center" style="width: 100px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ch in Model.BoDes)
                        {
                            <tr data-id="@ch.CauHoi" data-mamh="@ch.MaMH" data-trinhdo="@ch.TrinhDo" data-noidung="@ch.NoiDung"
                                data-a="@ch.DapAnA" data-b="@ch.DapAnB" data-c="@ch.DapAnC" data-d="@ch.DapAnD" data-dapan="@ch.DapAn"
                                data-original-mamh="@ch.MaMH" data-original-trinhdo="@ch.TrinhDo" data-original-noidung="@ch.NoiDung"
                                data-original-a="@ch.DapAnA" data-original-b="@ch.DapAnB" data-original-c="@ch.DapAnC"
                                data-original-d="@ch.DapAnD" data-original-dapan="@ch.DapAn">
                                <td><span class="badge bg-light text-secondary border border-light">@ch.CauHoi</span></td>
                                <td class="text-truncate fw-semibold" style="max-width: 250px;">@ch.NoiDung</td>
                                <td>@ch.MaMH</td>
                                <td>@ch.TrinhDo</td>
                                <td class="text-center"><span class="badge bg-secondary">@ch.DapAn</span></td>
                                <td class="text-center">
                                    <div class="d-flex gap-2 justify-content-center">
                                        <button type="button" class="btn btn-link text-warning p-0 btn-edit" title="Hiệu chỉnh"><i class="bi bi-pencil-square fs-5"></i></button>
                                        <button type="button" class="btn btn-link text-danger p-0 btn-delete" title="Xóa"><i class="bi bi-trash fs-5"></i></button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Card Footer Pagination -->
            <div class="card-footer d-flex justify-content-between align-items-center py-2 bg-light border-top-0">
                <div class="d-flex align-items-center gap-2">
                    <span class="small text-secondary fw-medium" id="lblPaginationSummary">Hiển thị từ 0 đến 0 trong tổng số 0 dòng</span>
                    <select class="form-select form-select-sm shadow-none" id="selectPageSize" style="width: 80px;" onchange="changePageSize(this.value)">
                        <option value="5">5</option>
                        <option value="10" selected>10</option>
                        <option value="20">20</option>
                        <option value="50">50</option>
                    </select>
                    <span class="small text-secondary fw-medium">dòng/trang</span>
                </div>
                <nav aria-label="Page navigation">
                    <ul class="pagination pagination-sm mb-0" id="ulPagination">
                        <!-- Pagination links injected here -->
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>

<!-- Custom Dialog Modal (Info / Confirm / Warning) -->
<div class="modal fade" id="customModal" tabindex="-1" aria-labelledby="customModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-3">
            <div class="modal-header border-0 bg-light py-3">
                <h5 class="modal-title d-flex align-items-center gap-2 fw-semibold" id="customModalLabel">
                    <i id="customModalIcon" class="bi fs-4"></i>
                    <span id="customModalTitle">Thông báo</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-4 fs-6 text-dark" id="customModalMessage">
                Nội dung thông báo ở đây.
            </div>
            <div class="modal-footer border-0 bg-light py-2">
                <button type="button" class="btn btn-secondary btn-sm px-3" id="btnCustomModalCancel" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary btn-sm px-3" id="btnCustomModalOk">Xác nhận</button>
            </div>
        </div>
    </div>
</div>

<!-- Import Excel Modal -->
<div class="modal fade" id="importModal" tabindex="-1" aria-labelledby="importModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-3">
            <div class="modal-header border-0 bg-light py-3">
                <h5 class="modal-title d-flex align-items-center gap-2 fw-semibold" id="importModalLabel">
                    <i class="bi bi-file-earmark-excel-fill text-success fs-4"></i>
                    <span>Import Câu hỏi trắc nghiệm từ Excel</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-4">
                <div class="mb-3 d-flex justify-content-between align-items-center bg-light p-3 rounded-3 border border-dashed">
                    <div>
                        <span class="fw-medium text-secondary">Tải file cấu trúc mẫu (.xlsx):</span>
                        <p class="mb-0 text-muted small">File gồm 8 cột: Mã môn học, Trình độ, Nội dung, Đáp án A, Đáp án B, Đáp án C, Đáp án D, Đáp án đúng</p>
                    </div>
                    <button type="button" class="btn btn-outline-success btn-sm px-3 animate-btn" onclick="downloadTemplate()">
                        <i class="bi bi-download"></i> Tải file mẫu
                    </button>
                </div>
                
                <div class="mb-4">
                    <label for="importFile" class="form-label fw-medium">Chọn file Excel (.xlsx, .xls)</label>
                    <input type="file" class="form-control shadow-none" id="importFile" accept=".xlsx, .xls" onchange="handleFileSelect(event)" />
                    <div id="importFileFeedback" class="text-danger small mt-1"></div>
                </div>

                <div id="importPreviewSection" style="display: none;">
                    <hr class="my-4 text-muted opacity-25" />
                    <h6 class="fw-semibold mb-3 d-flex justify-content-between align-items-center">
                        <span class="text-dark">Xem trước dữ liệu nhập</span>
                        <span id="importSummary" class="badge bg-secondary rounded-pill px-3 py-1.5">...</span>
                    </h6>
                    <div class="table-responsive border rounded-3" style="max-height: 280px; overflow-y: auto;">
                        <table class="table table-sm table-bordered table-hover align-middle mb-0" id="tblImportPreview">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th class="text-center" style="width: 50px;">STT</th>
                                    <th style="width: 150px;">Môn học & Cấp</th>
                                    <th>Nội dung câu hỏi</th>
                                    <th style="width: 200px;">Trạng thái</th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- Preview rows injected here dynamically -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 bg-light py-2">
                <button type="button" class="btn btn-secondary btn-sm px-3" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary btn-sm px-3 animate-btn" id="btnConfirmImport" onclick="confirmImport()" disabled>Xác nhận Import</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
    <script src="~/js/app-common.js" asp-append-version="true"></script>
    <script src="~/js/bode.js" asp-append-version="true"></script>
}
