@model List<DMS_Examify.Models.Lop>

@{
    ViewData["Title"] = "Quản lý Sinh viên";
    ViewData["Subtitle"] = "Quản lý Lớp & Sinh viên";
}

<div class="row g-4">
    <div class="col-md-4">
        <div class="card">
            <div class="card-header fw-bold">Quản lý Lớp</div>
            <div class="card-body">

                <input id="txtMaLop" class="form-control mb-2" placeholder="Mã lớp" disabled />
                <input id="txtTenLop" class="form-control mb-3" placeholder="Tên lớp" />

                <div class="d-flex gap-2 mb-3 flex-wrap">
                    <button class="btn btn-success" onclick="themLop()">Thêm</button>
                    <button class="btn btn-warning" onclick="suaLop()">Sửa</button>
                    <button class="btn btn-danger" onclick="xoaLop()">Xóa</button>
                    <button class="btn btn-secondary" onclick="undoLop()">Phục hồi</button>
                    <button class="btn btn-primary" onclick="ghiLop()">Ghi</button>
                </div>

                <ul class="list-group" id="lopList">
                    @foreach (var lop in Model)
                    {
                        <li class="list-group-item list-group-item-action" data-malop="@lop.MaLop" data-tenlop="@lop.TenLop"
                            onclick="chonLop(this)">
                            <b>@lop.TenLop</b> - @lop.MaLop
                        </li>
                    }
                </ul>

            </div>
        </div>
    </div>

    <div class="col-md-8">

        <input id="txtSearchSV" class="form-control mb-2" placeholder="Tìm kiếm sinh viên..." />

        <div class="card">
            <div class="card-header fw-bold">
                Sinh viên - <span id="currentLop" class="text-primary">Chưa chọn</span>
            </div>

            <div class="card-body">
                <div class="row g-2 mb-3">
                    <div class="col-md-4">
                        <input id="txtMaSV" class="form-control" placeholder="Mã SV" />
                    </div>
                    <div class="col-md-4">
                        <input id="txtHo" class="form-control" placeholder="Họ" />
                    </div>
                    <div class="col-md-4">
                        <input id="txtTen" class="form-control" placeholder="Tên" />
                    </div>

                    <div class="col-md-4">
                        <input id="txtNgaySinh" type="date" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <input id="txtDiaChi" class="form-control" placeholder="Địa chỉ" />
                    </div>
                    <div class="col-md-4">
                        <input id="txtMatKhau" class="form-control" placeholder="Mật khẩu" />
                    </div>
                </div>

                <div class="d-flex gap-2 flex-wrap mb-3">
                    <button class="btn btn-success" onclick="themSV()">Thêm</button>
                    <button class="btn btn-warning" onclick="suaSV()">Sửa</button>
                    <button class="btn btn-danger" onclick="xoaSV()">Xóa</button>
                    <button class="btn btn-secondary" onclick="undo()">Undo</button>
                    <button class="btn btn-info" onclick="timSV()">Tìm</button>
                    <button class="btn btn-primary" onclick="ghiSV()">Ghi</button>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Mã SV</th>
                                <th>Họ</th>
                                <th>Tên</th>
                                <th>Ngày sinh</th>
                                <th>Địa chỉ</th>
                            </tr>
                        </thead>
                        <tbody id="svTable"></tbody>
                    </table>
                </div>

            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        let selectedLop = null;
        let selectedLopRow = null;
        let selectedRow = null;

        let newItems = [];
        let updatedItems = [];
        let deletedItems = [];
        let historyStack = [];
        let tempId = -1;

        let newLops = [];
        let updatedLops = [];
        let deletedLops = [];
        let historyLop = [];

        function pushStateLop() {
            historyLop.push({
                html: lopList.innerHTML,
                newLops: JSON.parse(JSON.stringify(newLops)),
                updatedLops: JSON.parse(JSON.stringify(updatedLops)),
                deletedLops: JSON.parse(JSON.stringify(deletedLops))
            });
        }

                
        function undoLop() {
            if (!historyLop.length) return alert("Không có gì để undo");

            const s = historyLop.pop();
            lopList.innerHTML = s.html;

            newLops = s.newLops;
            updatedLops = s.updatedLops;
            deletedLops = s.deletedLops;

            bindLopRows();
        }

        function bindLopRows() {
            document.querySelectorAll("#lopList li").forEach(li => {
                li.onclick = () => chonLop(li);
            });
        }

        function chonLop(el) {

            document.querySelectorAll("#lopList li")
                .forEach(x => x.classList.remove("active"));

            el.classList.add("active");

            selectedLopRow = el;
            selectedLop = el.dataset.malop;

            txtMaLop.value = el.dataset.malop;
            txtTenLop.value = el.dataset.tenlop;

            currentLop.innerText = el.dataset.tenlop;

            newItems = [];
            updatedItems = [];
            deletedItems = [];
            historyStack = [];

            loadSinhVien();
        }

        function themLop() {
            const ma = txtMaLop.value.trim();
            const ten = txtTenLop.value.trim();

            if (!ma || !ten) return alert("Nhập đủ");

            pushStateLop();

            newLops.push({ MaLop: ma, TenLop: ten });

            const li = document.createElement("li");
            li.className = "list-group-item list-group-item-action";

            li.dataset.malop = ma;
            li.dataset.tenlop = ten;

            li.innerHTML = `<b>${ten}</b> - ${ma}`;

            li.onclick = () => chonLop(li);

            lopList.appendChild(li);
        }

        function suaLop() {
            if (!selectedLopRow) return alert("Chọn lớp");

            const oldMa = selectedLopRow.dataset.malop; // mã cũ
            const newMa = txtMaLop.value.trim();        // mã mới
            const ten = txtTenLop.value.trim();

            if (!newMa || !ten) return alert("Nhập đầy đủ");

            pushStateLop();

            selectedLopRow.dataset.malop = newMa;
            selectedLopRow.dataset.tenlop = ten;

            selectedLopRow.innerHTML = `<b>${ten}</b> - ${newMa}`;

            if (oldMa < 0) {
                const i = newLops.findIndex(x => x.MaLop == oldMa);
                if (i >= 0) {
                    newLops[i].MaLop = newMa;
                    newLops[i].TenLop = ten;
                }
            } else {
                updatedLops = updatedLops.filter(x => x.MaLop != oldMa);
                updatedLops.push({
                    OldMaLop: oldMa,
                    MaLop: newMa,
                    TenLop: ten
                });
            }
        }

        function xoaLop() {

            if (!selectedLopRow) return alert("Chọn lớp");

            const ma = selectedLopRow.dataset.malop;

            pushStateLop();

            if (ma < 0) {
                newLops = newLops.filter(x => x.MaLop != ma);
            } else {
                updatedLops = updatedLops.filter(x => x.MaLop != ma);

                if (!deletedLops.some(x => x.MaLop == ma))
                    deletedLops.push({ MaLop: ma });
            }

            selectedLopRow.remove();
            selectedLopRow = null;
        }

        async function ghiLop() {

            for (const d of deletedLops)
                await fetch(`/SinhVien/DeleteLop?maLop=${d.MaLop}`, { method: "POST" });

            for (const u of updatedLops)
                await fetch(`/SinhVien/UpdateLop`, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(u)
                });

            for (const n of newLops)
                await fetch(`/SinhVien/InsertLop`, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(n)
                });

            alert("Lưu lớp thành công");
            location.reload();
        }

        function pushState() {
            historyStack.push({
                html: svTable.innerHTML,
                newItems: JSON.parse(JSON.stringify(newItems)),
                updatedItems: JSON.parse(JSON.stringify(updatedItems)),
                deletedItems: JSON.parse(JSON.stringify(deletedItems))
            });
        }

        function undo() {
            if (!historyStack.length) return alert("Không có gì để undo");

            const s = historyStack.pop();
            svTable.innerHTML = s.html;

            newItems = s.newItems;
            updatedItems = s.updatedItems;
            deletedItems = s.deletedItems;

            bindRows();
            selectedRow = null;
        }


        function getForm() {
            return {
                MaSV: txtMaSV.value.trim(),
                Ho: txtHo.value.trim(),
                Ten: txtTen.value.trim(),
                NgaySinh: txtNgaySinh.value,
                DiaChi: txtDiaChi.value.trim(),
                MatKhau: txtMatKhau.value,
                MaLop: selectedLop   // 🔥 thêm dòng này
            };
        }

        function fillForm(row) {
            txtMaSV.value = row.dataset.masv;
            txtHo.value = row.dataset.ho;
            txtTen.value = row.dataset.ten;
            txtNgaySinh.value = row.dataset.ngaysinh;
            txtDiaChi.value = row.dataset.diachi;
        }


        function bindRows() {
            document.querySelectorAll("#svTable tr").forEach(r => {
                r.onclick = () => {
                    document.querySelectorAll("#svTable tr")
                        .forEach(x => x.classList.remove("table-active"));

                    r.classList.add("table-active");
                    selectedRow = r;
                    fillForm(r);
                };
            });
        }


        async function loadSinhVien() {

            if (!selectedLop) return;

            const res = await fetch('/SinhVien/GetByLop?maLop=' + selectedLop);
            const data = await res.json();

            svTable.innerHTML = "";

            data.forEach(sv => {
                const row = svTable.insertRow();

                row.dataset.masv = sv.maSV;
                row.dataset.ho = sv.ho;
                row.dataset.ten = sv.ten;
                row.dataset.ngaysinh = sv.ngaySinh ? sv.ngaySinh.slice(0, 10) : "";
                row.dataset.diachi = sv.diaChi;

                row.innerHTML = `
                                <td>${sv.maSV}</td>
                                <td>${sv.ho}</td>
                                <td>${sv.ten}</td>
                                <td>${sv.ngaySinh ? new Date(sv.ngaySinh).toLocaleDateString('vi-VN') : ""}</td>
                                <td>${sv.diaChi}</td>
                                `;
            });

            bindRows();
        }

        function themSV() {
            if (!selectedLop) return alert("Chọn lớp trước");

            const d = getForm();
            if (!d.MaSV) return alert("Nhập mã SV");

            pushState();

            const id = d.MaSV;

            const exists = [...svTable.rows].some(r => r.dataset.masv === id);
            if (exists) return alert("Mã sinh viên đã tồn tại");

            newItems.push({
                ...d,
                MaSV: id,
                MaLop: selectedLop
            });

            const row = svTable.insertRow();

            row.dataset.masv = id;
            row.dataset.ho = d.Ho;
            row.dataset.ten = d.Ten;
            row.dataset.ngaysinh = d.NgaySinh;
            row.dataset.diachi = d.DiaChi;

            row.innerHTML = `
            <td>${id}</td>
            <td>${d.Ho}</td>
            <td>${d.Ten}</td>
            <td>${d.NgaySinh}</td>
            <td>${d.DiaChi}</td>
        `;

            bindRows();
        }


        function suaSV() {
            if (!selectedRow) return alert("Chọn SV");

            const d = getForm();
            console.log(d);
            const id = selectedRow.dataset.masv;

            pushState();

            selectedRow.innerHTML = `
                <td>${id > 0 ? id : "..."}</td>
                <td>${d.Ho}</td>
                <td>${d.Ten}</td>
                <td>${d.NgaySinh}</td>
                <td>${d.DiaChi}</td>
            `;

            Object.assign(selectedRow.dataset, {
                masv: id,
                ho: d.Ho,
                ten: d.Ten,
                ngaysinh: d.NgaySinh,
                diachi: d.DiaChi
            });

            if (id < 0) {
                const i = newItems.findIndex(x => x.MaSV == id);
                if (i >= 0) newItems[i] = { ...d, MaSV: id, MaLop: selectedLop };
            } else {
                updatedItems = updatedItems.filter(x => x.MaSV != id);
                updatedItems.push({ ...d, MaSV: id.toString(), MaLop: selectedLop });
            }

            console.log(updatedItems);
        }


        function xoaSV() {
            if (!selectedRow) return alert("Chọn SV");

            const id = selectedRow.dataset.masv;

            pushState();

            if (id < 0) {
                newItems = newItems.filter(x => x.MaSV != id);
            } else {
                updatedItems = updatedItems.filter(x => x.MaSV != id);

                if (!deletedItems.some(x => x.MaSV == id))
                    deletedItems.push({ MaSV: id });
            }

            selectedRow.remove();
            selectedRow = null;
        }


        async function ghiSV() {

            for (const d of deletedItems)
                await fetch(`/SinhVien/Delete?maSV=${d.MaSV}`, { method: "POST" });

            for (const u of updatedItems)
                await fetch(`/SinhVien/Update`, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(u)
                });


            for (const n of newItems)
                await fetch(`/SinhVien/Insert`, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(n)
                });

            alert("Lưu thành công");
            @* location.reload(); *@
                }


        window.onload = bindLopRows;

    </script>
}