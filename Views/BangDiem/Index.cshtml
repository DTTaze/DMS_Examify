@model DMS_Examify.Models.BangDiemViewModel
@{
    ViewData["Title"] = "Bảng điểm môn học";
    ViewData["Subtitle"] = "In bảng điểm thi hết môn";
}

<style>
    @@media print {
        /* Ẩn toàn bộ layout: sidebar, navbar, bộ lọc, empty state */
        .sidebar, .navbar, .topbar, header, footer, nav,
        #emptyState,
        .card.mb-4.animate-in,
        .no-print {
            display: none !important;
        }

        /* Hiển thị bảng điểm chiếm toàn trang */
        #bangDiemContainer {
            display: block !important;
            border: none !important;
            box-shadow: none !important;
            margin: 0 !important;
        }

        /* Bỏ padding/margin thừa của layout */
        body, .main-content, .container, .container-fluid,
        .row, [class*="col-"] {
            margin: 0 !important;
            padding: 0 !important;
            width: 100% !important;
            max-width: 100% !important;
        }

        /* Đảm bảo bảng rõ ràng khi in */
        .grade-report th, .grade-report td {
            border: 1px solid #000 !important;
            color: #000 !important;
        }
    }
</style>

<div class="row justify-content-center">
    <div class="col-md-10">
        <!-- Bộ lọc -->
        <div class="card mb-4 animate-in">
            <div class="card-body">
                <div class="row g-3 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label">Lớp</label>
                        <select id="ddlLop" class="form-select">
                            <option value="">-- Chọn lớp --</option>
                            @foreach (var lop in Model.LopList)
                            {
                                <option value="@lop.MaLop">@lop.MaLop.Trim() - @lop.TenLop</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Môn học</label>
                        <select id="ddlMonHoc" class="form-select" disabled>
                            <option value="">-- Chọn môn học --</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Lần thi</label>
                        <select id="ddlLanThi" class="form-select" disabled>
                            <option value="">-- Lần --</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <button id="btnXem" class="btn btn-primary w-100" disabled>
                            <i class="bi bi-search me-1"></i> Xem
                        </button>
                    </div>
                    <div class="col-md-2">
                        <button id="btnIn" class="btn btn-outline-secondary w-100" disabled>
                            <i class="bi bi-printer me-1"></i> In
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Bảng điểm -->
        <div id="bangDiemContainer" class="card animate-in animate-in-delay-1" style="display:none;">
            <div class="card-body">
                <div class="grade-header">
                    <h4 style="font-weight:400; color:var(--text-secondary);">TRƯỜNG ĐẠI HỌC</h4>
                    <h3>BẢNG ĐIỂM THI HẾT MÔN</h3>
                    <div style="font-size:14px; color:var(--text-secondary);">
                        Lớp: <strong id="lblTenLop"></strong> &nbsp; | &nbsp;
                        Môn thi: <strong id="lblTenMH"></strong> &nbsp; | &nbsp;
                        Lần thi: <strong id="lblLanThi"></strong>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-bordered grade-report">
                        <thead>
                            <tr>
                                <th style="width:50px">STT</th>
                                <th style="width:90px">MASV</th>
                                <th>HỌ</th>
                                <th style="width:100px">TÊN</th>
                                <th style="width:80px">ĐIỂM</th>
                                <th style="width:90px">ĐIỂM CHỮ</th>
                            </tr>
                        </thead>
                        <tbody id="tbodyBangDiem">
                        </tbody>
                    </table>
                </div>

                <div class="row mt-4">
                    <div class="col-md-6">
                        <div style="font-size:13px; color:var(--text-secondary);">
                            Tổng số sinh viên: <strong id="lblTongSo">0</strong>
                        </div>
                    </div>
                    <div class="col-md-6 text-end">
                        <div style="font-size:13px; color:var(--text-secondary);">
                            Ngày in: <strong>@DateTime.Now.ToString("dd/MM/yyyy")</strong>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Trạng thái trống -->
        <div id="emptyState" class="card animate-in animate-in-delay-1">
            <div class="card-body text-center py-5">
                <i class="bi bi-journal-text" style="font-size:3rem; color:var(--text-secondary); opacity:0.5;"></i>
                <p class="mt-3" style="color:var(--text-secondary);">
                    Vui lòng chọn <strong>Lớp</strong>, <strong>Môn học</strong> và <strong>Lần thi</strong> rồi nhấn <strong>Xem</strong> để hiển thị bảng điểm.
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    const ddlLop = document.getElementById('ddlLop');
    const ddlMonHoc = document.getElementById('ddlMonHoc');
    const ddlLanThi = document.getElementById('ddlLanThi');
    const btnXem = document.getElementById('btnXem');
    const btnIn = document.getElementById('btnIn');
    const bangDiemContainer = document.getElementById('bangDiemContainer');
    const emptyState = document.getElementById('emptyState');
    const tbodyBangDiem = document.getElementById('tbodyBangDiem');

    btnIn.addEventListener('click', function () {
        const maLop = ddlLop.value;
        const maMH = ddlMonHoc.value;
        const lan = ddlLanThi.value;

        if (!maLop || !maMH || !lan) return;

        const url = `/BangDiem/InBangDiem?maLop=${encodeURIComponent(maLop)}&maMH=${encodeURIComponent(maMH)}&lan=${lan}`;
        window.open(url, '_blank');
    });

    ddlLop.addEventListener('change', function () {
        resetDropdown(ddlMonHoc, '-- Chọn môn học --');
        resetDropdown(ddlLanThi, '-- Lần --');
        disableControls(ddlLanThi, btnXem);
        hideBangDiem();

        const maLop = this.value;
        if (!maLop) {
            ddlMonHoc.disabled = true;
            return;
        }

        fetch(`/BangDiem/GetMonHoc?maLop=${encodeURIComponent(maLop)}`)
            .then(res => res.json())
            .then(result => {
                if (result.success && result.data.length > 0) {
                    result.data.forEach(item => {
                        const opt = document.createElement('option');
                        opt.value = item.maMH;
                        opt.textContent = item.tenMH;
                        ddlMonHoc.appendChild(opt);
                    });
                    ddlMonHoc.disabled = false;
                }
            })
            .catch(err => console.error('Lỗi khi tải môn học:', err));
    });

    ddlMonHoc.addEventListener('change', function () {
        resetDropdown(ddlLanThi, '-- Lần --');
        btnXem.disabled = true;
        hideBangDiem();

        const maLop = ddlLop.value;
        const maMH = this.value;
        if (!maLop || !maMH) {
            ddlLanThi.disabled = true;
            return;
        }

        fetch(`/BangDiem/GetLanThi?maLop=${encodeURIComponent(maLop)}&maMH=${encodeURIComponent(maMH)}`)
            .then(res => res.json())
            .then(result => {
                if (result.success && result.data.length > 0) {
                    result.data.forEach(lan => {
                        const opt = document.createElement('option');
                        opt.value = lan;
                        opt.textContent = `Lần ${lan}`;
                        ddlLanThi.appendChild(opt);
                    });
                    ddlLanThi.disabled = false;
                }
            })
            .catch(err => console.error('Lỗi khi tải lần thi:', err));
    });

    ddlLanThi.addEventListener('change', function () {
        btnXem.disabled = !this.value;
    });

    btnXem.addEventListener('click', function () {
        const maLop = ddlLop.value;
        const maMH = ddlMonHoc.value;
        const lan = ddlLanThi.value;

        if (!maLop || !maMH || !lan) return;

        btnXem.disabled = true;
        btnXem.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Đang tải...';

        const url = `/BangDiem/XemBangDiem?maLop=${encodeURIComponent(maLop)}&maMH=${encodeURIComponent(maMH)}&lan=${lan}`;

        fetch(url)
            .then(res => res.json())
            .then(result => {
                if (result.success) {
                    renderBangDiem(result);
                } else {
                    alert(result.message || 'Không thể tải bảng điểm.');
                }
            })
            .catch(err => {
                console.error('Lỗi khi tải bảng điểm:', err);
                alert('Đã xảy ra lỗi khi tải bảng điểm.');
            })
            .finally(() => {
                btnXem.disabled = false;
                btnXem.innerHTML = '<i class="bi bi-search me-1"></i> Xem';
            });
    });

    function renderBangDiem(data) {
        document.getElementById('lblTenLop').textContent = data.tenLop;
        document.getElementById('lblTenMH').textContent = data.tenMH;
        document.getElementById('lblLanThi').textContent = data.lan;
        document.getElementById('lblTongSo').textContent = data.tongSo;

        tbodyBangDiem.innerHTML = '';

        if (data.danhSach.length === 0) {
            tbodyBangDiem.innerHTML = `
                <tr>
                    <td colspan="6" class="text-center py-4" style="color:var(--text-secondary);">
                        <i class="bi bi-inbox"></i> Không có dữ liệu bảng điểm cho bộ lọc đã chọn.
                    </td>
                </tr>`;
        } else {
            data.danhSach.forEach(sv => {
                const chuaThi = sv.diem === null || sv.diem === undefined;
                const diemColor = chuaThi ? 'var(--text-secondary)' : sv.diem >= 8 ? 'var(--success)' : sv.diem >= 5 ? 'var(--warning)' : 'var(--danger)';
                const diemText = chuaThi ? 'Chưa thi' : sv.diem.toFixed(1);
                const diemChuText = chuaThi ? '' : `<span class="badge bg-dark">${sv.diemChu}</span>`;
                const row = document.createElement('tr');
                row.innerHTML = `
                    <td>${sv.stt}</td>
                    <td><strong>${sv.maSV}</strong></td>
                    <td style="text-align:left !important;">${sv.ho}</td>
                    <td style="text-align:left !important;">${sv.ten}</td>
                    <td style="font-weight:700; color:${diemColor};">${diemText}</td>
                    <td>${diemChuText}</td>`;
                tbodyBangDiem.appendChild(row);
            });
        }

        bangDiemContainer.style.display = '';
        emptyState.style.display = 'none';
        document.getElementById('btnIn').disabled = false;
    }

    function resetDropdown(dropdown, placeholder) {
        dropdown.innerHTML = `<option value="">${placeholder}</option>`;
    }

    function disableControls(...controls) {
        controls.forEach(c => c.disabled = true);
    }

    function hideBangDiem() {
        bangDiemContainer.style.display = 'none';
        emptyState.style.display = '';
        document.getElementById('btnIn').disabled = true;
    }
})();
</script>
}
