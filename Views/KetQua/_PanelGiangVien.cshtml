@* Panel: Danh sách đề thi - dành cho Giảng viên / PGV *@
<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-clipboard-data me-2"></i>Danh sách đề thi</span>
        <div class="d-flex gap-2">
            <select class="form-select form-select-sm" id="filterMonHocGV" style="width:200px;">
                <option value="">Tất cả môn</option>
            </select>
            <select class="form-select form-select-sm" id="filterLopGV" style="width:180px;">
                <option value="">Tất cả lớp</option>
            </select>
            <select class="form-select form-select-sm" id="filterLanGV" style="width:120px;">
                <option value="">Tất cả lần</option>
                <option value="1">Lần 1</option>
                <option value="2">Lần 2</option>
            </select>
        </div>
    </div>
    <div class="card-body p-0">
        <div id="gvLoading" class="text-center py-4">
            <span class="spinner-border spinner-border-sm me-2"></span>Đang tải...
        </div>
        <div class="table-responsive" id="gvTableWrap" style="display:none;">
            <table class="table">
                <thead>
                    <tr>
                        <th style="width:50px;">STT</th>
                        <th>Môn thi</th>
                        <th>Lớp</th>
                        <th style="width:70px;">Lần</th>
                        <th>Trình độ</th>
                        <th style="width:80px;">Số câu</th>
                        <th style="width:80px;">Phút</th>
                        <th>Ngày thi</th>
                        <th style="width:80px;">SV thi</th>
                        <th style="width:110px;"></th>
                    </tr>
                </thead>
                <tbody id="gvTableBody"></tbody>
            </table>
        </div>
        <div id="gvEmpty" class="text-center py-4 text-muted" style="display:none;">
            <i class="bi bi-inbox me-1"></i>Chưa có đề thi nào.
        </div>
    </div>
</div>
