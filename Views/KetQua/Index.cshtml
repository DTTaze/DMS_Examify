@{
    ViewData["Title"] = "Xem kết quả thi";
    ViewData["Subtitle"] = "Xem lại bài thi đã làm";
    var userRole = ViewData["UserRole"]?.ToString() ?? "";
    var userName = ViewData["UserName"]?.ToString() ?? "";
    var userLogin = ViewData["UserLogin"]?.ToString() ?? "";
}

<div class="row justify-content-center" id="ketQuaApp" data-role="@userRole"
     data-username="@userName" data-userlogin="@userLogin">
    <div class="col-md-11 animate-in">

        @if (userRole == "Sinhvien")
        {
            <partial name="_PanelSinhVien" />
        }

        @if (userRole == "Giangvien" || userRole == "PGV")
        {
            <partial name="_PanelGiangVien" />
        }

        <partial name="_PanelChiTiet" />
    </div>
</div>

@section Scripts {
    <script src="~/js/ketqua.js"></script>
}
